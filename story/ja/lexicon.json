 },
 "grammar": {
  "ja:grammar:desu-janaidesu": {
   "pattern": "〜です／〜じゃないです",
   "zh": "是～／不是～（丁寧的肯定與否定）。常體說成「〜だ／〜じゃない」。",
   "level": "N5",
   "introduced": "anime-w01-e01",
   "used_in": [
    "anime-w01-e01"
   ]
  },
  "ja:grammar:kara-kimashita": {
   "pattern": "〜から来ました",
   "zh": "從～來的（說出身地、出發地）。常體是「〜から来た」。",
   "level": "N5",
   "introduced": "anime-w01-e01",
   "used_in": [
    "anime-w01-e01"
   ]
  },
  "ja:grammar:masenka-mashou": {
   "pattern": "〜ませんか／〜ましょう",
   "zh": "邀約「要不要～？」／提議、回應邀約「～吧！」。常體說成「〜ない？」／「〜よう」。",
   "level": "N5",
   "introduced": "anime-w01-e02",
   "used_in": [
    "anime-w01-e02"
   ]
  },
  "ja:grammar:ndesu": {
   "pattern": "〜んです（説明）",
   "zh": "說明理由、狀況，或詢問原因時用，語氣比「〜です」更有「其實是這樣」的感覺。常體是「〜んだ／〜の」。",
   "level": "N5",
   "introduced": "anime-w01-e02",
   "used_in": [
    "anime-w01-e02"
   ]
  },
  "ja:grammar:futsuukei": {
   "pattern": "普通形（常体）入門：だ／じゃない／る／ない",
   "zh": "常體（普通形）：名詞＋だ／じゃない，動詞辭書形「〜る」／否定「〜ない」。跟朋友說話、動漫台詞、故事旁白都用；意思跟「です／ます」一樣。",
   "level": "N5",
   "introduced": "anime-w01-e03",
   "used_in": [
    "anime-w01-e03"
   ]
  },
  "ja:grammar:te-wa-ikenai": {
   "pattern": "〜てはいけない／〜ちゃだめ",
   "zh": "不可以～（禁止）。「〜ちゃだめ」是口語縮約：〜ては→〜ちゃ（〜では→〜じゃ），比「〜てはいけない」更隨性。",
   "level": "N5",
   "introduced": "anime-w01-e03",
   "used_in": [
    "anime-w01-e03"
   ]
  },
  "ja:grammar:yori-nohouga": {
   "pattern": "〜より〜のほうが",
   "zh": "比起 A，B 比較～（A より B のほうが＋形容詞）；只說「B のほうが」時省略了比較對象",
   "level": "N4",
   "introduced": "anime-w02-e04",
   "used_in": [
    "anime-w02-e04"
   ]
  },
  "ja:grammar:dake": {
   "pattern": "〜だけ",
   "zh": "只有～、只～（接在名詞、數量後面，表示限定）",
   "level": "N4",
   "introduced": "anime-w02-e04",
   "used_in": [
    "anime-w02-e04"
   ]
  },
  "ja:grammar:te-kureru-te-morau": {
   "pattern": "〜てくれる／〜てもらう",
   "zh": "別人為我做某事。「A が（我）に V てくれる」＝A 為我做；「（我）が A に V てもらう」＝我請 A 做、我得到 A 的幫忙。主語不同，但都帶感謝的心情",
   "level": "N4",
   "introduced": "anime-w02-e05",
   "used_in": [
    "anime-w02-e05"
   ]
  },
  "ja:grammar:naito-ikenai": {
   "pattern": "〜ないと（いけない）",
   "zh": "不～不行、必須～（動詞ない形去い＋と いけない）；口語常只說「〜ないと」就結束",
   "level": "N4",
   "introduced": "anime-w02-e05",
   "used_in": [
    "anime-w02-e05"
   ]
  },
  "ja:grammar:shuujoshi-zo-ze-wa": {
   "pattern": "終助詞 〜ぞ／〜ぜ／〜わ（役割語）",
   "zh": "句尾語氣詞。「ぞ」強烈宣告、警告；「ぜ」帥氣地邀約、宣告，都是男性強勢語氣。「わ」是女性語氣，動漫裡高傲的大小姐、女王、魔王也常用；魔王還會配上「我」「〜のだ」顯得威嚴",
   "level": "N4",
   "introduced": "anime-w02-e06",
   "used_in": [
    "anime-w02-e06"
   ]
  },
  "ja:grammar:te-shimau-chau": {
   "pattern": "〜てしまう／〜ちゃう",
   "zh": "①（動作）全部做完了 ②不小心、遺憾地做了。口語「〜てしまう」→「〜ちゃう」、「〜でしまう」→「〜じゃう」；過去形「〜ちゃった」",
   "level": "N4",
   "introduced": "anime-w02-e06",
   "used_in": [
    "anime-w02-e06"
   ]
  },
  "ja:grammar:te-kudasai": {
   "pattern": "〜てください",
   "zh": "請～（請求、指示）",
   "level": "N5",
   "introduced": "drama-w01-e01",
   "used_in": [
    "drama-w01-e01"
   ]
  },
  "ja:grammar:ni-kimashita": {
   "pattern": "〜に来ました（目的）",
   "zh": "來做～（V-ます去ます＋に／動作名詞＋に，表示來的目的）",
   "level": "N5",
   "introduced": "drama-w01-e01",
   "used_in": [
    "drama-w01-e01"
   ]
  },
  "ja:grammar:tai-desu": {
   "pattern": "〜たいです",
   "zh": "想要～（V-ます去ます＋たいです，說自己的願望）",
   "level": "N5",
   "introduced": "drama-w01-e02",
   "used_in": [
    "drama-w01-e02"
   ]
  },
  "ja:grammar:wa-doko-desuka": {
   "pattern": "〜はどこですか",
   "zh": "～在哪裡？（問地點）",
   "level": "N5",
   "introduced": "drama-w01-e02",
   "used_in": [
    "drama-w01-e02"
   ]
  },
  "ja:grammar:te-mo-ii-desuka": {
   "pattern": "〜てもいいですか",
   "zh": "可以～嗎？（請求許可）",
   "level": "N5",
   "introduced": "drama-w01-e03",
   "used_in": [
    "drama-w01-e03"
   ]
  },
  "ja:grammar:kara-riyuu": {
   "pattern": "〜から（理由）",
   "zh": "因為～（句子＋から，說明理由）",
   "level": "N5",
   "introduced": "drama-w01-e03",
   "used_in": [
    "drama-w01-e03"
   ]
  },
  "ja:grammar:ni-narimasu": {
   "pattern": "〜になります（接客）",
   "zh": "店員說明金額、位置或遞東西時的客氣說法，意思接近「〜です」。",
   "level": "N4",
   "introduced": "drama-w02-e04",
   "used_in": [
    "drama-w02-e04"
   ]
  },
  "ja:grammar:masu-ka": {
   "pattern": "〜ますか（申し出・確認）",
   "zh": "「要（我幫您）～嗎？」用動詞ます形加か，主動提議或確認對方要不要。店員用語常見「お〜しますか」。",
   "level": "N4",
   "introduced": "drama-w02-e04",
   "used_in": [
    "drama-w02-e04"
   ]
  },
  "ja:grammar:masu-kata": {
   "pattern": "〜方（V-ます＋方）",
   "zh": "動詞ます形去掉ます＋方（かた），表示「～的方法」：使い方（用法）、食べ方（吃法）、言い方（說法）。",
   "level": "N4",
   "introduced": "drama-w02-e05",
   "used_in": [
    "drama-w02-e05"
   ]
  },
  "ja:grammar:deshou-ka": {
   "pattern": "〜でしょうか",
   "zh": "比「〜ですか」更客氣、委婉的問法，向店員或陌生人請教時很好用。",
   "level": "N4",
   "introduced": "drama-w02-e05",
   "used_in": [
    "drama-w02-e05"
   ]
  },
  "ja:grammar:tara": {
   "pattern": "〜たら（道案内）",
   "zh": "動詞た形＋ら，「做了～之後（就會）…」。問路時用來說明下一步會看到什麼，例如「曲がったら、左にあります」。",
   "level": "N4",
   "introduced": "drama-w02-e06",
   "used_in": [
    "drama-w02-e06"
   ]
  },
  "ja:grammar:te-iru-joutai": {
   "pattern": "〜ている（状態）",
   "zh": "動詞て形＋いる，表示動作結果留下來的「狀態」：電池が切れています（沒電了）、ドアが閉まっています（門關著）。",
   "level": "N4",
   "introduced": "drama-w02-e06",
   "used_in": [
    "drama-w02-e06"
   ]
  }
 }
}
