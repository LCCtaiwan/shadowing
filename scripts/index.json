 "pron": [
  {
   "id": "ja-pron-p01",
   "title": "長音（伸ばす音）",
   "title_zh": "長音：拉長的音",
   "tip_zh": "日語每一拍長度相同，長音要多佔一整拍；台灣學習者常把長音唸短、也聽成短音。邊聽邊用手指數拍子，「おばさん」4拍、「おばあさん」5拍。",
   "items": 20,
   "path": "scripts/ja/pron/p01.json",
   "audio": "audio/ja/pron/p01"
  },
  {
   "id": "ja-pron-p02",
   "title": "促音（小さい「っ」）",
   "title_zh": "促音：停一拍的小っ",
   "tip_zh": "小「っ」本身不發聲，是一拍的「停頓」，台灣學習者常直接漏掉。聽到子音前面突然卡住、有一小段安靜，就是有っ。",
   "items": 20,
   "path": "scripts/ja/pron/p02.json",
   "audio": "audio/ja/pron/p02"
  },
  {
   "id": "ja-pron-p03",
   "title": "撥音「ん」と拗音「ゃ・ゅ・ょ」",
   "title_zh": "撥音與拗音：ん和小ゃゅょ",
   "tip_zh": "「ん」自己佔一拍，後面接母音時也不會跟母音連成「な行」；小ゃゅょ則和前一個假名合成一拍。「きよう」3拍、「きょう」2拍，數拍數最準。",
   "items": 20,
   "path": "scripts/ja/pron/p03.json",
   "audio": "audio/ja/pron/p03"
  },
  {
   "id": "ja-pron-p04",
   "title": "清音・濁音・半濁音",
   "title_zh": "清音、濁音、半濁音",
   "tip_zh": "中文的ㄍ、ㄉ是不送氣清音，所以台灣學習者常把詞中間的「か・た」聽成「が・だ」。濁音在發音前聲帶就先振動，聽起來較低沉；ぱ行雙唇有明顯的爆破感。",
   "items": 20,
   "path": "scripts/ja/pron/p04.json",
   "audio": "audio/ja/pron/p04"
  },
  {
   "id": "ja-pron-p05",
   "title": "長音・促音・拗音の総復習",
   "title_zh": "綜合複習：長音、促音、拗音",
   "tip_zh": "這組不練音高（例如雨／飴），只練「拍數」。長音、促音各多一拍，拗音的小ゃゅょ不算一拍；先數拍，再判斷是哪個詞。",
   "items": 20,
   "path": "scripts/ja/pron/p05.json",
   "audio": "audio/ja/pron/p05"
  },
  {
   "id": "ja-pron-p06",
   "title": "旅行・家族・アニメでよく聞く言葉",
   "title_zh": "旅行、家人、動漫常聽到的詞",
   "tip_zh": "旅遊、家人和動漫台詞裡常出現的詞混合複習。聽的時候先抓拍數（長音、促音、ん），再注意第一拍是清音還是濁音。",
   "items": 20,
   "path": "scripts/ja/pron/p06.json",
   "audio": "audio/ja/pron/p06"
  }
 ],
 "announce": [
  {
   "id": "ja-announce-a01",
   "kind": "announce",
   "title": "駅のアナウンス",
   "title_zh": "車站廣播",
   "tip_zh": "先抓「〇番線」和「〜行き」這兩個關鍵字，再聽列車種類（各駅停車／快速／急行）。「ご注意ください」「ご利用ください」前面那一句，通常就是你要做的事。",
   "level": "N4",
   "items": 8,
   "path": "scripts/ja/announce/a01.json",
   "audio": "audio/ja/announce/a01"
  },
  {
   "id": "ja-announce-a02",
   "kind": "announce",
   "title": "新幹線・特急の車内放送",
   "title_zh": "新幹線・特急車廂廣播",
   "tip_zh": "車內廣播通常先說「まもなく＋站名」，接著是「お出口は〜側です」和轉乘資訊。聽到「〜号車」「〜時〜分」時要特別留意數字，對號座和自由座也常一起出現。",
   "level": "N4",
   "items": 8,
   "path": "scripts/ja/announce/a02.json",
   "audio": "audio/ja/announce/a02"
  },
  {
   "id": "ja-announce-a03",
   "kind": "announce",
   "title": "空港のアナウンス",
   "title_zh": "機場廣播",
   "tip_zh": "機場廣播一開始會先說航空公司、班次（〜便）和目的地（〜行き），先確認是不是你的班機，再聽「ゲート」「時刻」「変更」。「変更になりました」「遅れる」後面接的就是新的資訊。",
   "level": "N4",
   "items": 8,
   "path": "scripts/ja/announce/a03.json",
   "audio": "audio/ja/announce/a03"
  },
  {
   "id": "ja-announce-a04",
   "kind": "announce",
   "title": "デパート・遊園地のアナウンス",
   "title_zh": "百貨公司・遊樂園廣播",
   "tip_zh": "商場廣播常先說全館的時間或地點，再用「なお／また」補充例外（餐廳、地下樓層），題目常考補充的那一句。走失兒童廣播要把顏色和「かぶる／はく／着る」配對起來聽。",
   "level": "N4",
   "items": 8,
   "path": "scripts/ja/announce/a04.json",
   "audio": "audio/ja/announce/a04"
  },
  {
   "id": "ja-announce-a05",
   "kind": "announce",
   "title": "遅延・運休・天気予報",
   "title_zh": "延誤・停駛・天氣預報",
   "tip_zh": "延誤廣播大多照這個順序：原因（〜の影響で）→狀況（運転を見合わせて）→恢復預估（見込み）→替代方案（代わりのバス）。天氣預報抓「降水確率」「〜度」，以及前面說的是早上還是下午。",
   "level": "N4",
   "items": 8,
   "path": "scripts/ja/announce/a05.json",
   "audio": "audio/ja/announce/a05"
  },
  {
   "id": "ja-announce-a06",
   "kind": "announce",
   "title": "緊急のお知らせ",
   "title_zh": "緊急廣播",
   "tip_zh": "緊急廣播先抓「〜てください」和「〜ないでください」：該做什麼、不要做什麼（不要搭電梯、不要急著往外跑）。聽到「係員の案内にしたがって」「落ち着いて」，就跟著工作人員冷靜行動。",
   "level": "N4",
   "items": 8,
   "path": "scripts/ja/announce/a06.json",
   "audio": "audio/ja/announce/a06"
  }
 ],
