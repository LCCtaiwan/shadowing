  "grammar": [
    {
      "id": "ja:grammar:te-moraemasenka",
      "pattern": "〜てもらえませんか",
      "zh": "可以請你～嗎？動詞て形＋もらえませんか，比「〜てください」更客氣的請求；常體是「〜てもらえない？」。陽太緊張到對同學也用了這個敬語，所以被吐槽",
      "level": "N4",
      "line": "s1-03",
      "surface": "やってもらえませんか",
      "examples": [
        {
          "text": "すみません、写真を撮ってもらえませんか。",
          "ruby": [
            [
              "すみません、"
            ],
            [
              "写真",
              "しゃしん"
            ],
            [
              "を"
            ],
            [
              "撮",
              "と"
            ],
            [
              "ってもらえませんか。"
            ]
          ],
          "zh": "不好意思，可以幫我拍張照嗎？"
        },
        {
          "text": "もう少しゆっくり話してもらえませんか。",
          "ruby": [
            [
              "もう"
            ],
            [
              "少",
              "すこ"
            ],
            [
              "しゆっくり"
            ],
            [
              "話",
              "はな"
            ],
            [
              "してもらえませんか。"
            ]
          ],
          "zh": "可以請你說慢一點嗎？"
        }
      ]
    },
    {
      "id": "ja:grammar:to-omoimasu",
      "pattern": "〜と思います",
      "zh": "我覺得～、我想～。普通形＋と思います（常體：と思う）；名詞、な形容詞要加「だ」：好きだと思う",
      "level": "N4",
      "line": "s1-05",
      "surface": "いいと思います",
      "examples": [
        {
          "text": "明日は雨が降ると思います。",
          "ruby": [
            [
              "明日",
              "あした"
            ],
            [
              "は"
            ],
            [
              "雨",
              "あめ"
            ],
            [
              "が"
            ],
            [
              "降",
              "ふ"
            ],
            [
              "ると"
            ],
            [
              "思",
              "おも"
            ],
            [
              "います。"
            ]
          ],
          "zh": "我想明天會下雨。"
        },
        {
          "text": "この店のラーメンが、日本で一番おいしいと思います。",
          "ruby": [
            [
              "この"
            ],
            [
              "店",
              "みせ"
            ],
            [
              "のラーメンが、"
            ],
            [
              "日本",
              "にほん"
            ],
            [
              "で"
            ],
            [
              "一番",
              "いちばん"
            ],
            [
              "おいしいと"
            ],
            [
              "思",
              "おも"
            ],
            [
              "います。"
            ]
          ],
          "zh": "我覺得這家店的拉麵是全日本最好吃的。"
        }
      ]
    }
