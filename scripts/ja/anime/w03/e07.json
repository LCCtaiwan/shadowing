  "grammar": [
    {
      "id": "ja:grammar:te-miru",
      "pattern": "〜てみる",
      "zh": "（試著）做做看。動詞て形＋みる；「〜てみなさい」是上對下的命令，名偵探叫人「說說看、看看看」就用它",
      "level": "N4",
      "line": "s2-04",
      "surface": "話してみなさい",
      "examples": [
        {
          "text": "この服、ちょっと着てみてもいいですか。",
          "ruby": [
            [
              "この"
            ],
            [
              "服",
              "ふく"
            ],
            [
              "、ちょっと"
            ],
            [
              "着",
              "き"
            ],
            [
              "てみてもいいですか。"
            ]
          ],
          "zh": "這件衣服可以試穿一下嗎？"
        },
        {
          "text": "日本のラーメンを、一度食べてみたいです。",
          "ruby": [
            [
              "日本",
              "にほん"
            ],
            [
              "のラーメンを、"
            ],
            [
              "一度",
              "いちど"
            ],
            [
              "食",
              "た"
            ],
            [
              "べてみたいです。"
            ]
          ],
          "zh": "我想吃一次看看日本的拉麵。"
        }
      ]
    },
    {
      "id": "ja:grammar:sugiru",
      "pattern": "〜すぎる",
      "zh": "太～、過於～。動詞ます形／い形容詞去「い」／な形容詞＋すぎる；吐槽別人時很常用",
      "level": "N4",
      "line": "s2-03",
      "surface": "早すぎる",
      "examples": [
        {
          "text": "このカレーは辛すぎて、食べられません。",
          "ruby": [
            [
              "このカレーは"
            ],
            [
              "辛",
              "から"
