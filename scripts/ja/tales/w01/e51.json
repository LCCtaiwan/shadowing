  "recap": {
    "text": "むかし、むかし、あるところにおじいさんとおばあさんがありました。",
    "zh": "很久很久以前，在某個地方住著一位老爺爺和一位老奶奶。",
    "ruby": [
      [
        "むかし、むかし、あるところにおじいさんとおばあさんがありました。"
      ]
    ]
  },
  "focus": {
    "title": "聽懂「〜てしまいました」與說話人的語氣",
    "zh": "注意聽「なめてしまいました」「ちょん切ってしまいました」這種表示「做完了、無法挽回」的說法，以及老奶奶兇巴巴、老爺爺溫柔的語氣差別。"
  },
  "scenes": [
