          "id": "s3-07",
          "speaker": "storyteller",
          "text": "「お待ち申しております。どうか気をつけてお帰り下さいまし。」",
          "ruby": [
            [
              "「お"
            ],
            [
              "待",
              "ま"
            ],
            [
              "ち"
            ],
            [
              "申",
              "もう"
            ],
