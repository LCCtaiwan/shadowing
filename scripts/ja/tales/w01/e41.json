  "recap": {
    "text": "むかし、むかし、あるところに、おじいさんとおばあさんがありました。",
    "ruby": [
      [
        "むかし、むかし、あるところに、おじいさんとおばあさんがありました。"
      ]
    ],
    "zh": "很久很久以前，在某個地方，住著一位老爺爺和一位老奶奶。"
  },
  "focus": {
    "title": "聽懂兩戶人家的對比與小白的叫聲",
    "zh": "注意聽「正直」和「欲ばり」兩對老夫婦的對比，以及小白「ここほれ、ワン、ワン」叫了之後，挖出了什麼。"
  },
  "scenes": [
    {
      "id": "s1",
      "kind": "scene",
      "setting_zh": "兩戶比鄰而居的人家",
      "lines": [
        {
          "id": "s1-01",
          "speaker": "storyteller",
          "text": "むかし、むかし、あるところに、おじいさんとおばあさんがありました。",
          "ruby": [
            [
              "むかし、むかし、あるところに、おじいさんとおばあさんがありました。"
            ]
          ],
          "zh": "很久很久以前，在某個地方，住著一位老爺爺和一位老奶奶。"
        },
        {
          "id": "s1-02",
          "speaker": "storyteller",
          "text": "正直な、人のいいおじいさんとおばあさんどうしでしたけれど、子どもがないので、",
          "ruby": [
            [
              "正直",
              "しょうじき"
            ],
            [
              "な、"
            ],
            [
              "人",
              "ひと"
            ],
            [
              "のいいおじいさんとおばあさんどうしでしたけれど、"
            ],
            [
              "子",
              "こ"
            ],
            [
              "どもがないので、"
            ]
          ],
          "zh": "他們是一對誠實又善良的老夫婦，可是因為沒有孩子，"
        },
        {
          "id": "s1-03",
          "speaker": "storyteller",
          "text": "飼犬の白を、ほんとうの子どものようにかわいがっていました。",
          "ruby": [
            [
              "飼犬",
              "かいいぬ"
            ],
            [
              "の"
            ],
            [
              "白",
              "しろ"
            ],
            [
              "を、ほんとうの"
            ],
            [
              "子",
              "こ"
            ],
            [
              "どものようにかわいがっていました。"
            ]
          ],
          "zh": "就把養的狗小白，當成親生孩子一樣疼愛。",
          "focus": [
            "かわいがっていました"
          ]
        },
        {
          "id": "s1-04",
          "speaker": "storyteller",
          "text": "白も、おじいさんとおばあさんに、それはよくなついていました。",
          "ruby": [
            [
              "白",
              "しろ"
            ],
            [
              "も、おじいさんとおばあさんに、それはよくなついていました。"
            ]
          ],
          "zh": "小白也非常親近老爺爺和老奶奶。"
        },
        {
          "id": "s1-05",
          "speaker": "storyteller",
          "text": "すると、おとなりにも、おじいさんとおばあさんがありました。",
          "ruby": [
            [
              "すると、おとなりにも、おじいさんとおばあさんがありました。"
            ]
          ],
          "zh": "這時，隔壁也住著一位老爺爺和一位老奶奶。"
        },
        {
          "id": "s1-06",
          "speaker": "storyteller",
          "text": "このほうは、いけない、欲ばりのおじいさんとおばあさんでした。",
          "ruby": [
            [
              "このほうは、いけない、"
            ],
            [
              "欲",
              "よく"
            ],
            [
              "ばりのおじいさんとおばあさんでした。"
            ]
          ],
          "zh": "這一對是壞心眼、貪心的老爺爺和老奶奶。",
          "focus": [
            "欲ばり"
          ]
        },
        {
          "id": "s1-07",
          "speaker": "storyteller",
          "text": "ですから、おとなりの白をにくらしがって、きたならしがって、",
          "ruby": [
            [
              "ですから、おとなりの"
            ],
            [
              "白",
              "しろ"
            ],
            [
              "をにくらしがって、きたならしがって、"
            ]
          ],
          "zh": "所以他們看隔壁的小白很不順眼，嫌牠髒，"
        },
        {
          "id": "s1-08",
          "speaker": "storyteller",
          "text": "いつもいじのわるいことばかりしていました。",
          "ruby": [
            [
              "いつもいじのわるいことばかりしていました。"
            ]
          ],
          "zh": "總是做些刁難牠的事。",
          "focus": [
            "いじのわるいこと"
          ]
        }
      ]
    },
    {
      "id": "s2",
      "kind": "scene",
      "setting_zh": "田裡・大朴樹下",
      "lines": [
        {
          "id": "s2-01",
          "speaker": "storyteller",
          "text": "ある日、正直おじいさんが、いつものようにくわをかついで、畑をほりかえしていますと、",
          "ruby": [
            [
              "ある"
            ],
            [
              "日",
              "ひ"
            ],
            [
              "、"
            ],
            [
              "正直",
              "しょうじき"
            ],
            [
              "おじいさんが、いつものようにくわをかついで、"
            ],
            [
              "畑",
              "はたけ"
            ],
            [
              "をほりかえしていますと、"
            ]
          ],
          "zh": "有一天，誠實的老爺爺像平常一樣扛著鋤頭，在田裡翻土，"
        },
        {
          "id": "s2-02",
          "speaker": "storyteller",
          "text": "白も一緒についてきて、そこらをくんくんかぎまわっていましたが、",
          "ruby": [
            [
              "白",
              "しろ"
            ],
            [
              "も"
            ],
            [
              "一緒",
              "いっしょ"
            ],
            [
              "についてきて、そこらをくんくんかぎまわっていましたが、"
            ]
          ],
          "zh": "小白也跟著一起來，在附近嗅來嗅去，"
        },
        {
          "id": "s2-03",
          "speaker": "storyteller",
          "text": "ふと、おじいさんのすそをくわえて、畑のすみの、大きなえのきの木の下までつれて行って、前足で土をかき立てながら、",
          "ruby": [
            [
              "ふと、おじいさんのすそをくわえて、"
            ],
            [
              "畑",
              "はたけ"
            ],
            [
              "のすみの、"
            ],
            [
              "大",
              "おお"
            ],
            [
              "きなえのきの"
            ],
            [
              "木",
              "き"
            ],
            [
              "の"
            ],
            [
              "下",
              "した"
            ],
            [
              "までつれて"
            ],
            [
              "行",
              "い"
            ],
            [
              "って、"
            ],
            [
              "前足",
              "まえあし"
            ],
            [
              "で"
            ],
            [
              "土",
              "つち"
            ],
            [
              "をかき"
            ],
            [
              "立",
              "た"
            ],
            [
              "てながら、"
            ]
          ],
          "zh": "忽然，牠咬住老爺爺的衣襬，把他拉到田角落一棵大朴樹下，用前腳扒著土，"
        },
        {
          "id": "s2-04",
          "speaker": "storyteller",
          "text": "「ここほれ、ワン、ワン。ここほれ、ワン、ワン」",
          "ruby": [
            [
              "「ここほれ、ワン、ワン。ここほれ、ワン、ワン」"
            ]
          ],
          "zh": "「挖這裡，汪、汪。挖這裡，汪、汪。」",
          "focus": [
            "ここほれ、ワン、ワン"
          ],
          "style": "白の声で、元気よく、歌うように"
        },
        {
          "id": "s2-05",
          "speaker": "storyteller",
          "text": "となきました。",
          "ruby": [
            [
              "となきました。"
            ]
          ],
          "zh": "這樣叫著。"
        }
      ]
    },
    {
      "id": "s3",
      "kind": "scene",
      "setting_zh": "田裡・挖出金幣",
      "lines": [
        {
          "id": "s3-01",
          "speaker": "storyteller",
          "text": "「なんだな、なんだな」",
          "ruby": [
            [
              "「なんだな、なんだな」"
            ]
          ],
          "zh": "「怎麼了，怎麼了？」",
          "style": "おじいさんの声で、のんびりと"
        },
        {
          "id": "s3-02",
          "speaker": "storyteller",
          "text": "と、おじいさんはいいながら、くわを入れてみますと、",
          "ruby": [
            [
              "と、おじいさんはいいながら、くわを"
            ],
            [
              "入",
              "い"
            ],
            [
              "れてみますと、"
            ]
          ],
          "zh": "老爺爺一邊說，一邊用鋤頭往下挖，"
        },
        {
          "id": "s3-03",
          "speaker": "storyteller",
          "text": "かちりと音がして、穴のそこできらきら光るものがありました。",
          "ruby": [
            [
              "かちりと"
            ],
            [
              "音",
              "おと"
            ],
            [
              "がして、"
            ],
            [
              "穴",
              "あな"
            ],
            [
              "のそこできらきら"
            ],
            [
              "光",
              "ひか"
            ],
            [
              "るものがありました。"
            ]
          ],
          "zh": "只聽喀嚓一聲，洞底有閃閃發亮的東西。"
        },
        {
          "id": "s3-04",
          "speaker": "storyteller",
          "text": "ずんずんほって行くと、小判がたくさん、出てきました。",
          "ruby": [
            [
              "ずんずんほって"
            ],
            [
              "行",
              "い"
            ],
            [
              "くと、"
            ],
            [
              "小判",
              "こばん"
            ],
            [
              "がたくさん、"
            ],
            [
              "出",
              "で"
            ],
            [
              "てきました。"
            ]
          ],
          "zh": "一直往下挖，挖出了好多金幣。"
        },
        {
          "id": "s3-05",
          "speaker": "storyteller",
          "text": "おじいさんはびっくりして、大きな声でおばあさんをよびたてて、",
          "ruby": [
            [
              "おじいさんはびっくりして、"
            ],
            [
              "大",
              "おお"
            ],
            [
              "きな"
            ],
            [
              "声",
              "こえ"
            ],
            [
              "でおばあさんをよびたてて、"
            ]
          ],
          "zh": "老爺爺嚇了一跳，大聲叫老奶奶過來，"
        },
        {
          "id": "s3-06",
          "speaker": "storyteller",
          "text": "えんやら、えんやら、小判をうちのなかへはこび込みました。",
          "ruby": [
            [
              "えんやら、えんやら、"
            ],
            [
              "小判",
              "こばん"
            ],
            [
              "をうちのなかへはこび"
            ],
            [
              "込",
              "こ"
            ],
            [
              "みました。"
            ]
          ],
          "zh": "嘿咻、嘿咻地把金幣搬進了家裡。"
        },
        {
          "id": "s3-07",
          "speaker": "storyteller",
          "text": "正直なおじいさんとおばあさんは、きゅうにお金持ちになりました。",
          "ruby": [
            [
              "正直",
              "しょうじき"
            ],
            [
              "なおじいさんとおばあさんは、きゅうにお"
            ],
            [
              "金持",
              "かねも"
            ],
            [
              "ちになりました。"
            ]
          ],
          "zh": "誠實的老爺爺和老奶奶，一下子變成了有錢人。",
          "focus": [
            "お金持ちになりました"
          ]
        }
      ]
    }
  ],
