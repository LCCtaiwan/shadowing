  "title": "まいごになったら",
  "title_zh": "如果走丟了",
  "recap": {
    "text": "きょうは大きいお店に来ました。人がたくさんいます。",
    "ruby": [
      [
        "きょうは"
      ],
      [
        "大",
        "おお"
      ],
      [
        "きいお"
      ],
      [
        "店",
        "みせ"
      ],
      [
        "に"
      ],
      [
        "来",
        "き"
      ],
      [
        "ました。"
      ],
      [
        "人",
        "ひと"
      ],
      [
        "がたくさんいます。"
      ]
    ],
    "zh": "今天來到一家很大的商場。人好多。"
  },
  "focus": {
    "title": "走丟時要會說的話",
    "zh": "記住三件事：①留在原地不要亂走（ここで待ちます）②不跟陌生人走，請對方找店員（お店の人を呼んでください）③跟店員說名字和年紀，拿出寫著爸媽電話和飯店名稱的卡片。"
  },
  "scenes": [
    {
      "id": "s1",
      "kind": "scene",
      "setting_zh": "大阪的大型商場。小米和阿寶看玩具看得太入迷，回頭發現媽媽不見了。",
      "lines": [
        {
          "id": "s1-01",
          "speaker": "abao",
          "text": "ママ…？ママ、いない…。",
          "ruby": [
            [
              "ママ…？ママ、いない…。"
            ]
          ],
          "zh": "媽媽……？媽媽不見了……。",
          "style": "泣きそうに"
        },
        {
          "id": "s1-02",
          "speaker": "xiaomi",
          "text": "だいじょうぶ。ここで待とう。動かないよ。",
          "ruby": [
            [
              "だいじょうぶ。ここで"
            ],
            [
              "待",
              "ま"
            ],
            [
              "とう。"
            ],
            [
              "動",
              "うご"
            ],
            [
              "かないよ。"
            ]
          ],
          "zh": "沒關係。我們在這裡等。不要亂走喔。",
          "focus": [
            "動かないよ"
          ],
          "style": "落ち着いて、弟を安心させるように"
        },
        {
          "id": "s1-03",
          "speaker": "passerby_f",
          "text": "どうしたの？おばさんといっしょに、ママを探しに行こうか。",
          "ruby": [
            [
              "どうしたの？おばさんといっしょに、ママを"
            ],
            [
              "探",
              "さが"
            ],
            [
              "しに"
            ],
            [
              "行",
              "い"
            ],
            [
              "こうか。"
            ]
          ],
          "zh": "怎麼了？要不要跟阿姨一起去找媽媽？"
        },
        {
          "id": "s1-04",
          "speaker": "xiaomi",
          "text": "いいえ、行きません。ここで待ちます。",
          "ruby": [
            [
              "いいえ、"
            ],
            [
              "行",
              "い"
            ],
            [
              "きません。ここで"
            ],
            [
              "待",
              "ま"
            ],
            [
              "ちます。"
            ]
          ],
          "zh": "不用，我不去。我在這裡等。",
          "focus": [
            "ここで待ちます"
          ],
          "style": "はっきり"
        },
        {
          "id": "s1-05",
          "speaker": "xiaomi",
          "text": "お店の人を呼んでください。",
          "ruby": [
            [
              "お"
            ],
            [
              "店",
              "みせ"
            ],
            [
              "の"
            ],
            [
              "人",
              "ひと"
            ],
            [
              "を"
            ],
            [
              "呼",
              "よ"
            ],
            [
              "んでください。"
            ]
          ],
          "zh": "請幫我叫店員來。",
          "focus": [
            "お店の人を呼んでください"
          ],
          "style": "はっきり、ゆっくり"
        },
        {
          "id": "s1-06",
          "speaker": "passerby_f",
          "text": "わかった。ちょっと待っててね。",
          "ruby": [
            [
              "わかった。ちょっと"
            ],
            [
              "待",
              "ま"
            ],
            [
              "っててね。"
            ]
          ],
          "zh": "好，等我一下喔。"
        }
      ]
    },
    {
      "id": "s2",
      "kind": "scene",
      "setting_zh": "店員過來幫忙。小米拿出媽媽事先放在她口袋裡的卡片，上面寫著媽媽的手機號碼和飯店名稱。",
      "lines": [
        {
          "id": "s2-01",
          "speaker": "staff_f",
          "text": "どうしましたか。",
          "ruby": [
            [
              "どうしましたか。"
            ]
          ],
          "zh": "怎麼了呢？",
          "style": "しゃがんで、やさしく"
        },
        {
          "id": "s2-02",
          "speaker": "xiaomi",
          "text": "ママがいません。まいごです。",
          "ruby": [
            [
              "ママがいません。まいごです。"
            ]
          ],
          "zh": "媽媽不見了。我們走丟了。",
          "focus": [
            "まいごです"
          ]
        },
        {
          "id": "s2-03",
          "speaker": "staff_f",
          "text": "だいじょうぶですよ。お名前は？何歳ですか。",
          "ruby": [
            [
              "だいじょうぶですよ。お"
            ],
            [
              "名前",
              "なまえ"
            ],
            [
              "は？"
            ],
            [
              "何歳",
              "なんさい"
            ],
            [
              "ですか。"
            ]
          ],
          "zh": "沒事的喔。叫什麼名字？幾歲呢？"
        },
        {
          "id": "s2-04",
          "speaker": "xiaomi",
          "text": "名前は小米です。七歳です。",
          "ruby": [
            [
              "名前",
              "なまえ"
            ],
            [
              "は"
            ],
            [
              "小米",
              "シャオミー"
            ],
            [
              "です。"
            ],
            [
              "七歳",
              "ななさい"
            ],
            [
              "です。"
            ]
          ],
          "zh": "我叫小米。七歲。",
          "focus": [
            "名前は小米です"
          ]
        },
        {
          "id": "s2-05",
          "speaker": "xiaomi",
          "text": "弟はアーバオです。四歳です。",
          "ruby": [
            [
              "弟",
              "おとうと"
            ],
            [
              "はアーバオです。"
            ],
            [
              "四歳",
              "よんさい"
            ],
            [
              "です。"
            ]
          ],
          "zh": "弟弟叫阿寶。四歲。"
        },
        {
          "id": "s2-06",
          "speaker": "staff_f",
          "text": "ママの電話番号、わかりますか。",
          "ruby": [
            [
              "ママの"
            ],
            [
              "電話番号",
              "でんわばんごう"
            ],
            [
              "、わかりますか。"
            ]
          ],
          "zh": "你知道媽媽的電話號碼嗎？",
          "focus": [
            "電話番号"
          ]
        },
        {
          "id": "s2-07",
          "speaker": "xiaomi",
          "text": "はい。このカードを見てください。",
          "ruby": [
            [
              "はい。このカードを"
            ],
            [
              "見",
              "み"
            ],
            [
              "てください。"
            ]
          ],
          "zh": "知道。請看這張卡片。",
          "focus": [
            "このカードを見てください"
          ]
        },
        {
          "id": "s2-08",
          "speaker": "staff_f",
          "text": "ママの電話番号と、ホテルの名前ですね。すぐ電話します。",
          "ruby": [
            [
              "ママの"
            ],
            [
              "電話番号",
              "でんわばんごう"
            ],
            [
              "と、ホテルの"
            ],
            [
              "名前",
              "なまえ"
            ],
            [
              "ですね。すぐ"
            ],
            [
              "電話",
              "でんわ"
            ],
            [
              "します。"
            ]
          ],
          "zh": "是媽媽的電話號碼和飯店的名字對吧。我馬上打電話。"
        },
        {
          "id": "s2-09",
          "speaker": "staff_f",
          "text": "ここで待っていてください。",
          "ruby": [
            [
              "ここで"
            ],
            [
              "待",
              "ま"
            ],
            [
              "っていてください。"
            ]
          ],
          "zh": "請在這裡等一下喔。"
        },
        {
          "id": "s2-10",
          "speaker": "jiahui",
          "text": "小米！アーバオ！",
          "ruby": [
            [
              "小米",
              "シャオミー"
            ],
            [
              "！アーバオ！"
            ]
          ],
          "zh": "小米！阿寶！",
          "style": "走ってきて、ほっとして"
        },
        {
          "id": "s2-11",
          "speaker": "xiaomi",
          "text": "ママ！ここで待ってたよ！",
          "ruby": [
            [
              "ママ！ここで"
            ],
            [
              "待",
              "ま"
            ],
            [
              "ってたよ！"
            ]
          ],
          "zh": "媽媽！我們一直在這裡等喔！"
        },
        {
          "id": "s2-12",
          "speaker": "jiahui",
          "text": "本当にありがとうございました。",
          "ruby": [
            [
              "本当",
              "ほんとう"
            ],
            [
              "にありがとうございました。"
            ]
          ],
          "zh": "真的非常謝謝您。",
          "style": "深くおじぎをして"
        }
      ]
    }
  ],
