  "title": "いっしょにあそぼう（公園で）",
  "title_zh": "一起玩吧（在公園）",
  "recap": {
    "text": "きょうは公園に来ました。そうたくんもいます。",
    "ruby": [
      [
        "きょうは"
      ],
      [
        "公園",
        "こうえん"
      ],
      [
        "に"
      ],
      [
        "来",
        "き"
      ],
      [
        "ました。そうたくんもいます。"
      ]
    ],
    "zh": "今天來到公園。そうた也在。"
  },
  "focus": {
    "title": "邀朋友：「いっしょにあそぼう！」",
    "zh": "想跟日本小朋友玩，就說「いっしょにあそぼう！」；想加入說「いれて！」，想借東西說「〜てもいい？」，對方說「いいよ！」就是可以。"
  },
  "scenes": [
    {
      "id": "s1",
      "kind": "scene",
      "setting_zh": "大阪的公園。小米和阿寶看到在飯店認識的そうた正在溜滑梯。",
      "lines": [
        {
          "id": "s1-01",
          "speaker": "xiaomi",
          "text": "あ、そうたくんだ！",
          "ruby": [
            [
              "あ、そうたくんだ！"
            ]
          ],
          "zh": "啊，是そうた！"
        },
        {
          "id": "s1-02",
          "speaker": "sota",
          "text": "シャオミーちゃん！アーバオくん！こっち、こっち！",
          "ruby": [
            [
              "シャオミーちゃん！アーバオくん！こっち、こっち！"
            ]
          ],
          "zh": "小米！阿寶！這邊這邊！",
          "style": "手をふって"
        },
        {
          "id": "s1-03",
          "speaker": "xiaomi",
          "text": "いっしょにあそぼう！",
          "ruby": [
            [
              "いっしょにあそぼう！"
            ]
          ],
          "zh": "一起玩吧！",
          "focus": [
            "いっしょにあそぼう"
          ],
          "style": "元気に"
        },
        {
          "id": "s1-04",
          "speaker": "sota",
          "text": "うん、あそぼう！すべり台、行こう！",
          "ruby": [
            [
              "うん、あそぼう！すべり"
            ],
            [
              "台",
              "だい"
            ],
            [
              "、"
            ],
            [
              "行",
              "い"
            ],
            [
              "こう！"
            ]
          ],
          "zh": "好啊，來玩！去溜滑梯吧！"
        },
        {
          "id": "s1-05",
          "speaker": "abao",
          "text": "アーバオも！いれて！",
          "ruby": [
            [
              "アーバオも！いれて！"
            ]
          ],
          "zh": "阿寶也要！讓我一起玩！",
          "focus": [
            "いれて"
          ]
        },
        {
          "id": "s1-06",
          "speaker": "sota",
          "text": "いいよ！",
          "ruby": [
            [
              "いいよ！"
            ]
          ],
          "zh": "好啊！",
          "focus": [
            "いいよ"
          ]
        },
        {
          "id": "s1-07",
          "speaker": "xiaomi",
          "text": "順番ね。そうたくん、どうぞ。",
          "ruby": [
            [
              "順番",
              "じゅんばん"
            ],
            [
              "ね。そうたくん、どうぞ。"
            ]
          ],
          "zh": "要輪流喔。そうた，你先請。"
        },
        {
          "id": "s1-08",
          "speaker": "sota",
          "text": "ありがとう！次は、シャオミーちゃんね。",
          "ruby": [
            [
              "ありがとう！"
            ],
            [
              "次",
              "つぎ"
            ],
            [
              "は、シャオミーちゃんね。"
            ]
          ],
          "zh": "謝謝！下一個換小米喔。"
        }
      ]
    },
    {
      "id": "s2",
      "kind": "scene",
      "setting_zh": "接著在草地上玩球。天色漸暗，中村さん來叫そうた回家。",
      "lines": [
        {
          "id": "s2-01",
          "speaker": "xiaomi",
          "text": "そうたくん、そのボール、使ってもいい？",
          "ruby": [
            [
              "そうたくん、そのボール、"
            ],
            [
              "使",
              "つか"
            ],
            [
              "ってもいい？"
            ]
          ],
          "zh": "そうた，那顆球可以借我玩嗎？",
          "focus": [
            "使ってもいい"
          ]
        },
        {
          "id": "s2-02",
          "speaker": "sota",
          "text": "いいよ！みんなでやろう！",
          "ruby": [
            [
              "いいよ！みんなでやろう！"
            ]
          ],
          "zh": "可以啊！大家一起玩吧！"
        },
        {
          "id": "s2-03",
          "speaker": "abao",
          "text": "ボール、ぽーん！",
          "ruby": [
            [
              "ボール、ぽーん！"
            ]
          ],
          "zh": "球，碰～！",
          "style": "楽しそうに"
        },
        {
          "id": "s2-04",
          "speaker": "nakamura",
          "text": "そうた、そろそろ帰るよ。",
          "ruby": [
            [
              "そうた、そろそろ"
            ],
            [
              "帰",
              "かえ"
            ],
            [
              "るよ。"
            ]
          ],
          "zh": "そうた，差不多該回家囉。"
        },
        {
          "id": "s2-05",
          "speaker": "sota",
          "text": "えー、もうちょっと！",
          "ruby": [
            [
              "えー、もうちょっと！"
            ]
          ],
          "zh": "咦～再玩一下下！",
          "style": "ふくれて"
        },
        {
          "id": "s2-06",
          "speaker": "xiaomi",
          "text": "中村さん、いっしょに写真をとってもいいですか。",
          "ruby": [
            [
              "中村",
              "なかむら"
            ],
            [
              "さん、いっしょに"
            ],
            [
              "写真",
              "しゃしん"
            ],
            [
              "をとってもいいですか。"
            ]
          ],
          "zh": "中村阿姨，可以一起拍張照嗎？",
          "focus": [
            "写真をとってもいいですか"
          ]
        },
        {
          "id": "s2-07",
          "speaker": "nakamura",
          "text": "ええ、いいですよ。はい、チーズ！",
          "ruby": [
            [
              "ええ、いいですよ。はい、チーズ！"
            ]
          ],
          "zh": "好啊，可以喔。來，笑一個！"
        },
        {
          "id": "s2-08",
          "speaker": "xiaomi",
          "text": "また、あしたあそぼうね！",
          "ruby": [
            [
              "また、あしたあそぼうね！"
            ]
          ],
          "zh": "明天再一起玩吧！",
          "focus": [
            "あしたあそぼうね"
          ]
        },
        {
          "id": "s2-09",
          "speaker": "sota",
          "text": "うん！またね！",
          "ruby": [
            [
              "うん！またね！"
            ]
          ],
          "zh": "嗯！再見囉！",
          "focus": [
            "またね"
          ]
        },
        {
          "id": "s2-10",
          "speaker": "abao",
          "text": "バイバーイ！",
          "ruby": [
            [
              "バイバーイ！"
            ]
          ],
          "zh": "掰掰～！",
          "card": false
        }
      ]
    }
  ],
