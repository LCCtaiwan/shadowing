{
  "id": "ja-kids-w01-e03",
  "lang": "ja",
  "series": "kids",
  "week": 1,
  "episode": 3,
  "level": "N5",
  "title": "これください（アイスやさんで）",
  "title_zh": "請給我這個（在冰淇淋店）",
  "recap": {
    "text": "きょうは京都です。とても暑いです。アイスが食べたいです！",
    "ruby": [
      [
        "きょうは"
      ],
      [
        "京都",
        "きょうと"
      ],
      [
        "です。とても"
      ],
      [
        "暑",
        "あつ"
      ],
      [
        "いです。アイスが"
      ],
      [
        "食",
        "た"
      ],
      [
        "べたいです！"
      ]
    ],
    "zh": "今天在京都。天氣好熱。好想吃冰淇淋！"
  },
  "focus": {
    "title": "用「これください」點東西",
    "zh": "指著想要的東西說「これください」；店員問「いくつですか」時，用「ひとつ、ふたつ」回答。"
  },
  "scenes": [
    {
      "id": "s1",
      "kind": "scene",
      "setting_zh": "京都街上的冰淇淋店。小米和阿寶自己點冰淇淋，媽媽在旁邊幫忙付錢。",
      "lines": [
        {
          "id": "s1-01",
          "speaker": "staff_f",
          "text": "いらっしゃいませ！",
          "ruby": [
            [
              "いらっしゃいませ！"
            ]
          ],
          "zh": "歡迎光臨！",
          "style": "明るく"
        },
        {
          "id": "s1-02",
          "speaker": "xiaomi",
          "text": "こんにちは！",
          "ruby": [
            [
              "こんにちは！"
            ]
          ],
          "zh": "你好！",
          "card": false
        },
        {
          "id": "s1-03",
          "speaker": "staff_f",
          "text": "どのアイスにしますか。",
          "ruby": [
            [
              "どのアイスにしますか。"
            ]
          ],
          "zh": "要哪一種冰淇淋呢？"
        },
        {
          "id": "s1-04",
          "speaker": "xiaomi",
          "text": "これください！",
          "ruby": [
            [
              "これください！"
            ]
          ],
          "zh": "請給我這個！",
          "focus": [
            "これください"
          ],
          "style": "指をさして、元気に"
        },
        {
          "id": "s1-05",
          "speaker": "staff_f",
          "text": "抹茶ですね。いくつですか。",
          "ruby": [
            [
              "抹茶",
              "まっちゃ"
            ],
            [
              "ですね。いくつですか。"
            ]
          ],
          "zh": "抹茶口味對吧。要幾個呢？",
          "focus": [
            "いくつですか"
          ]
        },
        {
          "id": "s1-06",
          "speaker": "xiaomi",
          "text": "ひとつください。",
          "ruby": [
            [
              "ひとつください。"
            ]
          ],
          "zh": "請給我一個。",
          "focus": [
            "ひとつください"
          ]
        },
        {
          "id": "s1-07",
          "speaker": "abao",
          "text": "アーバオは、いちご！",
          "ruby": [
            [
              "アーバオは、いちご！"
            ]
          ],
          "zh": "阿寶要草莓！"
        },
        {
          "id": "s1-08",
          "speaker": "xiaomi",
          "text": "いちごも、ひとつください。",
          "ruby": [
            [
              "いちごも、ひとつください。"
            ]
          ],
          "zh": "草莓也請給我一個。"
        },
        {
          "id": "s1-09",
          "speaker": "staff_f",
          "text": "抹茶といちごで、ふたつですね。カップとコーン、どちらがいいですか。",
          "ruby": [
            [
              "抹茶",
              "まっちゃ"
            ],
            [
              "といちごで、ふたつですね。カップとコーン、どちらがいいですか。"
            ]
          ],
          "zh": "抹茶和草莓，一共兩個對吧。要杯裝還是甜筒呢？"
        },
        {
          "id": "s1-10",
          "speaker": "xiaomi",
          "text": "コーンがいいです！",
          "ruby": [
            [
              "コーンがいいです！"
            ]
          ],
          "zh": "我要甜筒！",
          "focus": [
            "コーンがいいです"
          ]
        },
        {
          "id": "s1-11",
          "speaker": "staff_f",
          "text": "はい、どうぞ。とけるから、気をつけてね。",
          "ruby": [
            [
              "はい、どうぞ。とけるから、"
            ],
            [
              "気",
              "き"
            ],
            [
              "をつけてね。"
            ]
          ],
          "zh": "來，請拿好。會融化喔，要小心。"
        },
        {
          "id": "s1-12",
          "speaker": "xiaomi",
          "text": "ありがとうございます！",
          "ruby": [
            [
              "ありがとうございます！"
            ]
          ],
          "zh": "謝謝您！"
        }
      ]
    },
    {
      "id": "s2",
      "kind": "scene",
      "setting_zh": "兩姊弟坐在店門口的長椅上吃冰淇淋。",
      "lines": [
        {
          "id": "s2-01",
          "speaker": "abao",
          "text": "冷たい！おいしいね！",
          "ruby": [
            [
              "冷",
              "つめ"
            ],
            [
              "たい！おいしいね！"
            ]
          ],
          "zh": "好冰！好好吃喔！"
        },
        {
          "id": "s2-02",
          "speaker": "xiaomi",
          "text": "うん、おいしいね！",
          "ruby": [
            [
              "うん、おいしいね！"
            ]
          ],
          "zh": "嗯，好好吃喔！"
        },
        {
          "id": "s2-03",
          "speaker": "abao",
          "text": "おねえちゃん、手がべたべた…。",
          "ruby": [
            [
              "おねえちゃん、"
            ],
            [
              "手",
              "て"
            ],
            [
              "がべたべた…。"
            ]
          ],
          "zh": "姊姊，手黏黏的……。",
          "style": "困って"
        },
        {
          "id": "s2-04",
          "speaker": "xiaomi",
          "text": "すみません、ティッシュをください。",
          "ruby": [
            [
              "すみません、ティッシュをください。"
            ]
          ],
          "zh": "不好意思，請給我面紙。",
          "focus": [
            "ティッシュをください"
          ]
        },
        {
          "id": "s2-05",
          "speaker": "staff_f",
          "text": "はい、どうぞ。",
          "ruby": [
            [
              "はい、どうぞ。"
            ]
          ],
          "zh": "好的，請用。",
          "card": false
        }
      ]
    }
  ],
