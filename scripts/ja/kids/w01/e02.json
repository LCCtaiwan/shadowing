            [
              "を"
            ],
            [
              "上",
              "あ"
            ],
            [
              "がってください。"
            ]
          ],
          "zh": "企鵝在二樓喔。請從那個樓梯上去。",
          "focus": [
            "二階"
          ]
        },
        {
          "id": "s2-05",
          "speaker": "xiaomi",
          "text": "二階ですね。ありがとうございます！",
          "ruby": [
            [
              "二階",
              "にかい"
            ],
            [
              "ですね。ありがとうございます！"
            ]
          ],
          "zh": "二樓對吧。謝謝您！"
        },
        {
          "id": "s2-06",
          "speaker": "xiaomi",
          "text": "わあ、ペンギン！かわいいね。",
          "ruby": [
            [
              "わあ、ペンギン！かわいいね。"
            ]
          ],
          "zh": "哇，企鵝！好可愛喔。"
        },
        {
          "id": "s2-07",
          "speaker": "abao",
          "text": "おねえちゃん、お水、飲みたい。",
          "ruby": [
            [
              "おねえちゃん、お"
