      ],
      [
        "がたくさんいます。"
      ]
    ],
    "zh": "今天全家一起來到水族館。有好多大魚。"
  },
  "focus": {
    "title": "用「〜はどこですか」問地方",
    "zh": "找廁所、找想看的東西時說「〜はどこですか」；注意聽對方回答的位置：横（旁邊）、前（前面）、二階（二樓）。"
  },
  "scenes": [
    {
      "id": "s1",
      "kind": "scene",
      "setting_zh": "大阪的水族館。看到一半，阿寶突然想上廁所。小米用剛學的日語幫弟弟問工作人員。",
      "lines": [
        {
          "id": "s1-01",
          "speaker": "abao",
          "text": "おねえちゃん、トイレ、行きたい…。",
          "ruby": [
            [
              "おねえちゃん、トイレ、"
            ],
            [
              "行",
              "い"
            ],
            [
              "きたい…。"
            ]
          ],
          "zh": "姊姊，我想上廁所……。",
          "style": "もじもじして"
        },
        {
          "id": "s1-02",
          "speaker": "xiaomi",
          "text": "えっ、トイレ？ちょっと待ってね。",
          "ruby": [
            [
              "えっ、トイレ？ちょっと"
            ],
            [
              "待",
              "ま"
            ],
            [
              "ってね。"
            ]
          ],
          "zh": "咦，廁所？等一下喔。"
        },
        {
          "id": "s1-03",
          "speaker": "xiaomi",
          "text": "すみません。トイレはどこですか。",
          "ruby": [
            [
              "すみません。トイレはどこですか。"
            ]
          ],
          "zh": "不好意思，請問廁所在哪裡？",
          "focus": [
            "トイレはどこですか"
          ],
          "style": "はっきり、ゆっくり"
        },
        {
          "id": "s1-04",
          "speaker": "staff_f",
          "text": "トイレですね。あそこのエレベーターの横ですよ。",
          "ruby": [
            [
              "トイレですね。あそこのエレベーターの"
            ],
            [
              "横",
              "よこ"
            ],
            [
              "ですよ。"
            ]
          ],
          "zh": "廁所嗎？在那邊電梯的旁邊喔。",
          "focus": [
            "エレベーターの横"
          ],
          "style": "子どもに合わせてやさしく"
        },
        {
          "id": "s1-05",
          "speaker": "xiaomi",
          "text": "エレベーターの横ですね。ありがとうございます！",
          "ruby": [
            [
              "エレベーターの"
            ],
            [
              "横",
              "よこ"
            ],
            [
              "ですね。ありがとうございます！"
            ]
          ],
          "zh": "電梯旁邊對吧。謝謝您！"
        },
        {
          "id": "s1-06",
          "speaker": "abao",
          "text": "ありがとう！",
          "ruby": [
            [
              "ありがとう！"
            ]
          ],
          "zh": "謝謝！",
          "style": "走りながら"
        }
      ]
    },
    {
