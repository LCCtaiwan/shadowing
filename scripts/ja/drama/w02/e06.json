  "grammar": [
    {
      "id": "ja:grammar:tara",
      "pattern": "〜たら（〜之後／如果〜）",
      "zh": "動詞た形＋ら：「做了～之後（就）…」，前面加「もし」就是假設「如果～的話」。店員說「試着したら、声をかけてください」是「試穿好之後叫我」；「もしサイズが合わなかったら」是「如果尺寸不合的話」。",
      "level": "N4",
      "line": "s1-05",
      "surface": "試着したら",
      "examples": [
        {
          "text": "家に帰ったら、すぐお風呂に入ります。",
          "ruby": [
            [
              "家",
              "いえ"
            ],
            [
              "に"
            ],
            [
              "帰",
              "かえ"
            ],
            [
              "ったら、すぐお"
            ],
            [
              "風呂",
              "ふろ"
            ],
            [
              "に"
            ],
            [
              "入",
              "はい"
            ],
            [
              "ります。"
            ]
          ],
          "zh": "回到家之後，馬上去洗澡。"
        },
        {
          "text": "もし雨が降ったら、映画館に行きましょう。",
          "ruby": [
            [
              "もし"
            ],
            [
              "雨",
              "あめ"
            ],
            [
              "が"
            ],
            [
              "降",
              "ふ"
            ],
            [
              "ったら、"
            ],
            [
              "映画館",
              "えいがかん"
            ],
            [
              "に"
            ],
            [
              "行",
              "い"
            ],
            [
              "きましょう。"
            ]
          ],
          "zh": "如果下雨的話，就去電影院吧。"
        }
      ]
    },
    {
      "id": "ja:grammar:te-iru-joutai",
      "pattern": "〜ている（状態）",
      "zh": "動詞て形＋いる，描述動作之後留下來的狀態或眼前的樣子：「着ている」（穿著）、「かかっている」（掛著）、「電気がついている」（燈亮著）。",
      "level": "N4",
      "line": "s2-07",
      "surface": "着ている",
      "examples": [
