  "grammar": [
    {
      "id": "ja:grammar:o-kite-imasu",
      "pattern": "〜を着ています／〜をかぶっています（服装）",
      "zh": "描述穿著。上衣、衣服用「着ています」，帽子用「かぶっています」，褲子、鞋子用「はいています」。「〜ている」表示穿上之後的狀態；放在名詞前面修飾時說「青いTシャツを着た男の子」。",
      "level": "N4",
      "line": "s2-05",
