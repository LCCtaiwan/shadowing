{
  "id": "ja-pron-p01",
  "lang": "ja",
  "title": "長音（伸ばす音）",
  "title_zh": "長音：拉長的音",
  "tip_zh": "日語每一拍長度相同，長音要多佔一整拍；台灣學習者常把長音唸短、也聽成短音。邊聽邊用手指數拍子，「おばさん」4拍、「おばあさん」5拍。",
  "items": [
    {
      "id": "p01-01",
      "contrast": "長音",
      "a": {
        "text": "おばさん",
        "reading": "おばさん",
        "zh": "阿姨、伯母"
      },
      "b": {
        "text": "おばあさん",
        "reading": "おばあさん",
        "zh": "奶奶、老婆婆"
      },
      "note_zh": "おばあさん的「ばあ」拉長一拍：4拍 vs 5拍"
    },
    {
      "id": "p01-02",
      "contrast": "長音",
      "a": {
        "text": "おじさん",
