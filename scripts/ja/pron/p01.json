        "zh": "叔叔、伯父"
      },
      "b": {
        "text": "おじいさん",
        "reading": "おじいさん",
        "zh": "爺爺、老爺爺"
      },
      "note_zh": "おじいさん的「じい」拉長一拍：4拍 vs 5拍"
    },
