      "contrast": "濁音",
      "a": {
        "text": "天気",
        "reading": "てんき",
        "zh": "天氣"
      },
      "b": {
        "text": "電気",
        "reading": "でんき",
        "zh": "電燈、電"
      },
      "note_zh": "第一拍「て」清音 vs「で」濁音"
    },
