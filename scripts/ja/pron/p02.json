  "id": "ja-pron-p02",
  "lang": "ja",
  "title": "促音（小さい「っ」）",
  "title_zh": "促音：停一拍的小っ",
  "tip_zh": "小「っ」本身不發聲，是一拍的「停頓」，台灣學習者常直接漏掉。聽到子音前面突然卡住、有一小段安靜，就是有っ。",
  "items": [
    {
      "id": "p02-01",
      "contrast": "促音",
      "a": {
        "text": "来て",
        "reading": "きて",
        "zh": "來（て形）"
      },
      "b": {
        "text": "切手",
        "reading": "きって",
        "zh": "郵票"
      },
      "note_zh": "切手在「き」和「て」之間停一拍：2拍 vs 3拍"
    },
    {
