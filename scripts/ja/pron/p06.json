      "a": {
        "text": "雪",
        "reading": "ゆき",
        "zh": "雪"
      },
      "b": {
        "text": "勇気",
        "reading": "ゆうき",
        "zh": "勇氣"
      },
      "note_zh": "勇気的「ゆ」拉長：2拍 vs 3拍"
    },
    {
