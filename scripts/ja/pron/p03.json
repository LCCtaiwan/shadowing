{
  "id": "ja-pron-p03",
  "lang": "ja",
  "title": "撥音「ん」と拗音「ゃ・ゅ・ょ」",
  "title_zh": "撥音與拗音：ん和小ゃゅょ",
  "tip_zh": "「ん」自己佔一拍，後面接母音時也不會跟母音連成「な行」；小ゃゅょ則和前一個假名合成一拍。「きよう」3拍、「きょう」2拍，數拍數最準。",
  "items": [
    {
      "id": "p03-01",
      "contrast": "撥音",
      "a": {
        "text": "記念",
        "reading": "きねん",
        "zh": "紀念"
      },
      "b": {
        "text": "禁煙",
        "reading": "きんえん",
        "zh": "禁菸"
      },
      "note_zh": "禁煙是「き・ん・え・ん」4拍，ん和え不連成「ね」；記念「き・ね・ん」3拍"
    },
    {
      "id": "p03-02",
      "contrast": "撥音",
      "a": {
        "text": "他人",
        "reading": "たにん",
        "zh": "別人、外人"
      },
      "b": {
        "text": "担任",
        "reading": "たんにん",
        "zh": "班導師"
      },
      "note_zh": "担任在「た」後多一個「ん」：3拍 vs 4拍"
    },
