{
 "recap": {
  "file": "recap.mp3",
  "hash": "d233254e039d39f9",
  "text": "台湾のエンジニア、リン・ユーシャン、二十六歳。仕事をやめて、一人でにほんに来ました。入国審査が終わって、今から東京へ行きます。",
  "voice": "Schedar",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "dd1aa848dabde5d7",
  "text": "いらっしゃいませ。どうぞ。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "1746e83dc6dbaea7",
  "text": "すみません。スカイライナーで上野まで、一枚お願いします。",
  "voice": "Iapetus",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "2feb29a1ad283dea",
  "text": "かしこまりました。次は十時半発です。発車まであと五分ですが、よろしいですか。",
  "voice": "Kore",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "98cda15d5db881db",
  "text": "五分！？じゃあ、その次の電車にしてください。",
  "voice": "Iapetus",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "bc85a7c2ae381567",
  "text": "はい、十一時発ですね。お席は窓側と通路側、どちらがよろしいですか。",
  "voice": "Kore",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "ac53f5aa9f593087",
  "text": "窓側をお願いします。あの……ふじさんは見えますか。",
  "voice": "Iapetus",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-07": {
  "file": "s1-07.mp3",
  "hash": "45a915efca6547cf",
  "text": "ふじさんは……ちょっと見えませんね。",
  "voice": "Kore",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-08": {
  "file": "s1-08.mp3",
  "hash": "5f6f5d4c8e70fce6",
  "text": "そうですか……。でも、窓側でお願いします。",
  "voice": "Iapetus",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-09": {
  "file": "s1-09.mp3",
  "hash": "55b24b6d155f9421",
  "text": "上野まで、二千五百七十円です。",
  "voice": "Kore",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-10": {
  "file": "s1-10.mp3",
  "hash": "71fe09a7cbc42f1b",
  "text": "カードでお願いします。",
  "voice": "Iapetus",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-11": {
  "file": "s1-11.mp3",
  "hash": "e713a6482e19d983",
  "text": "では、こちらにカードを入れてください。",
  "voice": "Kore",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-12": {
  "file": "s1-12.mp3",
  "hash": "3de0559ae26011ae",
  "text": "こちら、指定席のチケットです。四号車のじゅうにエー、窓側のお席です。",
  "voice": "Kore",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-13": {
  "file": "s1-13.mp3",
  "hash": "fd4eeb6177e1a47d",
  "text": "乗り場は地下です。あちらのエスカレーターで下に行ってください。",
  "voice": "Kore",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-14": {
  "file": "s1-14.mp3",
  "hash": "21fb08a5bc4d391e",
  "text": "四号車のじゅうにエー……。ありがとうございます！",
  "voice": "Iapetus",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-15": {
  "file": "s1-15.mp3",
  "hash": "62967417ab83549b",
  "text": "よかった……。ちゃんと全部わかりました。",
  "voice": "Iapetus"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "269c26c6a9f12ec7",
  "text": "すみません、じゅうにエーは……ここですか。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "c4fa1160671fa4b8",
  "text": "はい、そこですよ。大きいスーツケースですね。どちらから来ましたか。",
  "voice": "Erinome",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "08d5498d5590a38b",
  "text": "台湾から来ました。たいちゅうです。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "80eb70cda2a12a93",
  "text": "あら、台湾！去年、たいぺいに行きましたよ。しょうろんぽう、おいしかったです。",
  "voice": "Erinome",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "451465ffcef56363",
  "text": "にほんには、お仕事で？",
  "voice": "Erinome",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "c440b187a8f7adcd",
  "text": "すみません。台湾ドルを円にしてください。",
  "voice": "Iapetus"
 },
 "s3-02": {
  "file": "s3-02.mp3",
  "hash": "d2bba0e56f8f297f",
  "text": "かしこまりました。こちらの紙に、金額とお名前を書いてください。",
  "voice": "Charon"
 },
 "s3-03": {
  "file": "s3-03.mp3",
  "hash": "79b39cf17197a6c2",
  "text": "はい。……一万たいわんドルです。",
  "voice": "Iapetus"
 },
 "s3-04": {
  "file": "s3-04.mp3",
  "hash": "238fbf06670672f1",
  "text": "お待たせしました。四万七千円です。ご確認ください。",
  "voice": "Charon"
 },
 "s3-05": {
  "file": "s3-05.mp3",
  "hash": "4dcc02a11b9f5654",
  "text": "ありがとうございます。",
  "voice": "Iapetus"
 },
 "s3-06": {
  "file": "s3-06.mp3",
  "hash": "119bb570d432ab8e",
  "text": "仕事じゃありません。旅行に来ました。……よし。",
  "voice": "Iapetus"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "b30b9b225f322833",
  "text": "すみません、もう少しゆっくり言ってください。",
  "voice": "Sulafat",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "9207d3b269b79690",
  "text": "この紙に名前を書いてください。",
  "voice": "Sulafat",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "dbe006628480b02a",
  "text": "友達に会いに来ました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "c33dfca1c55fdd68",
  "text": "浅草へ写真を撮りに来ました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
