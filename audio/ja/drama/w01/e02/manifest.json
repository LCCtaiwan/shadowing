{
 "recap": {
  "file": "recap.mp3",
  "hash": "271ab1a2c8b63491",
  "text": "スカイライナーで上野に着いたユーシャン。ゲストハウスのチェックインは三時からです。それまで、大きいスーツケースを預けたいです。",
  "voice": "Schedar",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "130ea568dd3c1f41",
  "text": "コインロッカー、コインロッカー……。あ、ありました。",
  "voice": "Iapetus",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "36b7cea71b1ad3d0",
  "text": "あれ？全部「使用中」です……。",
  "voice": "Iapetus",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "88235ed5b031f0da",
  "text": "あ、あそこ！一つ空いています！",
  "voice": "Iapetus",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "f9d58329e5620113",
  "text": "よいしょ……。あれ？スーツケースが入りません。",
  "voice": "Iapetus",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "aab9ffa7008d5692",
  "text": "すみません。このスーツケースを預けたいです。大きいロッカーはどこですか。",
  "voice": "Iapetus",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "4621c1c9cf88c049",
  "text": "大きいロッカーですか。申し訳ありません、今日はどこもいっぱいです。",
  "voice": "Charon",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-07": {
  "file": "s1-07.mp3",
  "hash": "83d3105be1bbf2f8",
  "text": "あっ、出ました！スイカです！",
  "voice": "Iapetus"
 }
}
