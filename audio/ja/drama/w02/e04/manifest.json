{
 "recap": {
  "file": "recap.mp3",
  "hash": "2f6be3fc128171f9",
  "text": "ゲストハウスに荷物を置いたユーシャン。おなかがすいたので、近くのコンビニに行きます。",
  "voice": "Schedar",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "a1f4c0e37a548611",
  "text": "いらっしゃいませー。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "d2cd09fd1b542ceb",
  "text": "わあ、お弁当がたくさんありますね。",
  "voice": "Iapetus",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "f8025814779c6a26",
  "text": "からあげ弁当と、アイスを買います。あとは……お茶。",
  "voice": "Iapetus",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "8f20e0d445d93b3f",
  "text": "すみません、お茶はどこですか。",
  "voice": "Iapetus",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "27d155d30bc4ea81",
  "text": "お茶は、あちらの奥の冷蔵庫になります。",
  "voice": "Charon",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "8f2a24f3f543d12e",
  "text": "お次のお客様、どうぞー。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "8b1d639738ffc019",
  "text": "お弁当、温めますか。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "50ad559f9fdb41af",
  "text": "はい、お願いします。",
  "voice": "Iapetus",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "6aafca43855dc85d",
  "text": "袋はご利用ですか。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "681bdf76f3c26de4",
  "text": "あ、はい。一つください。",
  "voice": "Iapetus",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "9e04e46a26e13401",
  "text": "アイスは袋をお分けしますか。",
  "voice": "Kore",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "23fd0f5b88cbfe2c",
  "text": "え？すみません、もう一度お願いします。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-08": {
  "file": "s2-08.mp3",
  "hash": "de11dce9feef790b",
  "text": "温かいお弁当と、冷たいアイスです。袋を二つに分けますか。",
  "voice": "Kore",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-09": {
  "file": "s2-09.mp3",
  "hash": "783c9fa2110c0ef2",
  "text": "あ、はい。分けてください。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-10": {
  "file": "s2-10.mp3",
  "hash": "5b1c94e26e3221c5",
  "text": "お箸とスプーンはおつけしますか。",
  "voice": "Kore",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-11": {
  "file": "s2-11.mp3",
  "hash": "50ad559f9fdb41af",
  "text": "はい、お願いします。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-12": {
  "file": "s2-12.mp3",
  "hash": "1a18f55291bd1157",
  "text": "ポイントカードはお持ちですか。",
  "voice": "Kore",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-13": {
  "file": "s2-13.mp3",
  "hash": "a2ea959cd2b13881",
  "text": "えっと……はい、お願いします。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-14": {
  "file": "s2-14.mp3",
  "hash": "ea5f0accca06963e",
  "text": "あ……カード、ありますか？",
  "voice": "Kore",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-15": {
  "file": "s2-15.mp3",
  "hash": "9ef4fa229e1c22cf",
  "text": "あっ、カード……ないです。すみません。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-16": {
  "file": "s2-16.mp3",
  "hash": "ecfc3327c6c51856",
  "text": "大丈夫ですよ。お会計、九百二十円になります。",
  "voice": "Kore",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-17": {
  "file": "s2-17.mp3",
  "hash": "389f112289e278b0",
  "text": "スイカでもいいですか。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-18": {
  "file": "s2-18.mp3",
  "hash": "685660330858668d",
  "text": "はい。こちらにタッチをお願いします。",
  "voice": "Kore",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-19": {
  "file": "s2-19.mp3",
  "hash": "9523d85eb74886cf",
  "text": "ありがとうございます。こちら、レシートになります。",
  "voice": "Kore",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "22b5945577b0d41b",
  "text": "お弁当はまだ温かいです。アイスは冷たいです。袋を分けて、よかったです。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s3-02": {
  "file": "s3-02.mp3",
  "hash": "9f5df57e38dedca6",
  "text": "「温めますか」「おつけしますか」……コンビニでは、質問がたくさんありますね。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s3-03": {
  "file": "s3-03.mp3",
  "hash": "fca955e738a47228",
  "text": "でも、ポイントカードの時は、ちょっと恥ずかしかったです。",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s3-04": {
  "file": "s3-04.mp3",
  "hash": "e94639008278836c",
  "text": "あしたは、ラーメンを食べに行きます！",
  "voice": "Iapetus",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "50db30d4619d7d82",
  "text": "こちらがお部屋の鍵になります。",
  "voice": "Sulafat",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "8d3faa4de97eedb4",
  "text": "お支払いは現金だけになります。",
  "voice": "Sulafat",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "29b007223cbd64b1",
  "text": "コーヒーに砂糖を入れますか。",
  "voice": "Sulafat",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "32b5bec3b7a83912",
  "text": "寒いですね。窓を閉めますか。",
  "voice": "Sulafat",
  "model": "gemini-2.5-flash-preview-tts"
 },
