{
 "recap": {
  "file": "recap.mp3",
  "hash": "afde264a94f1f279",
  "text": "シャオユーと陽太が「屋上で待ってる」を録音しました。二人とも顔が赤くなりました。",
  "voice": "Schedar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "ce41653b77b422fb",
  "text": "みんな、聞きなさい。生徒会から手紙が来たわ。",
  "voice": "Despina",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "7450180a2b2ad9bc",
  "text": "文化祭までに、部員が五人いなければならないの。今は、よにんよ。",
  "voice": "Despina",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "c2295dc6b8aded1b",
  "text": "あと一人か…。よし、今日の録音で、がっこうじゅうを熱くするぜ！",
  "voice": "Fenrir",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "d80d17313892ac47",
  "text": "今日は『最後のパス』です。バスケットボールの試合の話です。",
  "voice": "Leda",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "bc24fb13c545fb79",
  "text": "わたしは、ボールの音を作りながら、実況をしますぅ。",
  "voice": "Achernar",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "4c8f058e51d157de",
  "text": "あー、バスケか。…声、出しすぎるなよ。",
  "voice": "Umbriel",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "10f5dab27369360a",
  "text": "残り十秒！五十八対六十！ボールは、陽太選手の手に！",
  "voice": "Achernar",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "30c7019968a0ca2d",
  "text": "走りなさい！最後まで、あきらめちゃだめよ！",
  "voice": "Despina",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "4d7add5dc4fce186",
  "text": "足が重い…。でも、俺は走らなければならないんだ！",
  "voice": "Fenrir",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "460fc75493ea9910",
  "text": "走りながら、仲間を探す。…どこだ、どこにいる！",
  "voice": "Fenrir",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "8fa50cca762280f7",
  "text": "残り五秒！陽太選手の前に、二人います！",
  "voice": "Achernar",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "fe216359356236b1",
  "text": "くっ…シュートは無理だ…！",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-09": {
  "file": "s2-09.mp3",
  "hash": "5d879c45d04ed5f6",
  "text": "ボールが…飛んでいきます！スリーポイントシュート…！",
  "voice": "Achernar",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-10": {
  "file": "s2-10.mp3",
  "hash": "1ce5d3ec724b6366",
  "text": "ビーーッ！…入りましたぁ！六十一たい六十、逆転ですぅ！",
  "voice": "Achernar",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-11": {
  "file": "s2-11.mp3",
  "hash": "6a2f4e78f932d5ed",
  "text": "やった…！あんたたち、最高のチームよ！",
  "voice": "Despina",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "373f832f49975638",
  "text": "カットですぅ。…あれぇ？ドアの外に、だれかいますよぉ。",
  "voice": "Achernar",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-02": {
  "file": "s3-02.mp3",
  "hash": "ce726f5314a94392",
  "text": "あ、あの…すみません。一年の悠斗です。ひなさんと同じクラスです。",
  "voice": "Sadachbia",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "cfa76ed8a6295a30",
  "text": "先輩！こっちです！わたし、空いています！",
  "voice": "Leda",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-08": {
  "file": "s2-08.mp3",
  "hash": "bd47cfaa82db785c",
  "text": "お前を信じるぜ！いけえっ！最後のパスだ！",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-03": {
  "file": "s3-03.mp3",
  "hash": "099efceef23e01a8",
  "text": "廊下で聞きながら、ずっとドキドキしていました。ぼくも、ラジオ部に入りたいです！",
  "voice": "Sadachbia",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-04": {
  "file": "s3-04.mp3",
  "hash": "048a03dfec6aa4bd",
  "text": "五人目だ！やったぜ、部長！",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-05": {
  "file": "s3-05.mp3",
  "hash": "3cc965374db0cd2f",
  "text": "べ、別に、泣いてないわよ！…ようこそ、ラジオ部へ。",
  "voice": "Despina",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-06": {
  "file": "s3-06.mp3",
  "hash": "7841a622edd6d64b",
  "text": "…ほら、入部届だ。ここに名前を書け。生徒会には、俺が出しておく。",
  "voice": "Umbriel",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-08": {
  "file": "s3-08.mp3",
  "hash": "2c7f9c08ee8112ea",
  "text": "えっ…生徒会長の、弟さん…！？",
  "voice": "Leda",
  "model": "gemini-3.8-flash-tts"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "43697610794b54dd",
  "text": "あしたは、六時に起きなければなりません。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "db33d879ef6d2fc4",
  "text": "図書館の本は、来週までに返さなければならない。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "b65adbc082e7f509",
  "text": "音楽を聞きながら、宿題をします。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "a23bbfb0a2c65416",
  "text": "歩きながら、スマホを見ないでください。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-07": {
  "file": "s3-07.mp3",
  "hash": "5429ac2746c09675",
  "text": "はい！あ、でも…実は、ぼくの姉は、生徒会長なんです。",
  "voice": "Sadachbia",
  "model": "gemini-3.8-flash-tts"
 },
