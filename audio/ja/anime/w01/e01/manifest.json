{
 "recap": {
  "file": "recap.mp3",
  "hash": "5c2f8337125cbb1a",
  "text": "台湾から来たシャオユーは、今日から東京の高校の二年生です。",
  "voice": "Schedar"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "746a633796a3834d",
  "text": "あー、静かに。転校生だ。自己紹介して。",
  "voice": "Umbriel"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "ab76f73260df47d5",
  "text": "はじめまして。シャオユーです。",
  "voice": "Leda"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "9df6250423e304b3",
  "text": "台湾の高雄から来ました。どうぞよろしくお願いします。",
  "voice": "Leda"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "da08bf31fca489c7",
  "text": "えっ、台湾から来たの？すごい！",
  "voice": "Callirrhoe"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "2027d025259fd334",
  "text": "はい、質問！シャオユーさんは、アイドルですか？",
  "voice": "Puck"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "0080e214a8f45af2",
  "text": "えっ？いいえ、アイドルじゃないです。普通の学生です。",
  "voice": "Leda"
 },
 "s1-07": {
  "file": "s1-07.mp3",
  "hash": "63ebf14e834189cd",
  "text": "台湾の人は、みんなタピオカが好き？",
  "voice": "Callirrhoe"
 },
 "s1-08": {
  "file": "s1-08.mp3",
  "hash": "e1a768fb23220d9a",
  "text": "みんなじゃないです。でも……わたしは大好きです。",
  "voice": "Leda"
 },
 "s1-09": {
  "file": "s1-09.mp3",
  "hash": "f2092027c22026a8",
  "text": "はい、そこまで。席はあそこだ。……俺は寝る。",
  "voice": "Umbriel"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "1cbcf37d1a20bf4e",
  "text": "シャオユーさん、にほんご、上手だね。",
  "voice": "Callirrhoe"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "03e79fa04af96a5d",
  "text": "いいえ、まだ上手じゃないです。みんなのにほんごは、ちょっと速いです。",
  "voice": "Leda"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "cb67853091792bdb",
  "text": "大丈夫だよ！俺たち、ぜんぜん速くないよ！",
  "voice": "Puck"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "ca7d442c7efa529c",
  "text": "……今、すごく速かったです。",
  "voice": "Leda"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "d01c25080cb50c88",
  "text": "うおおお！危ないぞー！",
  "voice": "Fenrir"
 },
 "s3-02": {
  "file": "s3-02.mp3",
  "hash": "075d54e7c9af4b44",
  "text": "ごめん！大丈夫か？",
  "voice": "Fenrir"
 },
 "s3-03": {
  "file": "s3-03.mp3",
  "hash": "874ab35cd54977dd",
  "text": "は、はい。大丈夫です。",
  "voice": "Leda"
 },
 "s3-04": {
  "file": "s3-04.mp3",
  "hash": "e27b8475e186ca47",
  "text": "あれ？お前、転校生だろ？",
  "voice": "Fenrir"
 },
 "s3-05": {
  "file": "s3-05.mp3",
  "hash": "1b99dcfd12a277d8",
  "text": "はい。二年生のシャオユーです。台湾から来ました。",
  "voice": "Leda"
 },
 "s3-06": {
  "file": "s3-06.mp3",
  "hash": "48107e97f519106e",
  "text": "台湾から？すげえ！俺は陽太。同じ二年だぜ！",
  "voice": "Fenrir"
 },
 "s3-07": {
  "file": "s3-07.mp3",
  "hash": "b5bcc0ff1fa334f4",
  "text": "あの……それは何ですか？",
  "voice": "Leda"
 },
 "s3-08": {
  "file": "s3-08.mp3",
  "hash": "d2406cbbdba54547",
  "text": "これか？マイクスタンドだ！かっこいいだろ！",
  "voice": "Fenrir"
 },
 "s3-09": {
  "file": "s3-09.mp3",
  "hash": "98a1fafd31ae9fc2",
  "text": "陽太さんは……歌手ですか？",
  "voice": "Leda"
 },
 "s3-10": {
  "file": "s3-10.mp3",
  "hash": "90cb97758be32d6b",
  "text": "歌手じゃない！ラジオ部だ！",
  "voice": "Fenrir"
 },
 "s3-11": {
  "file": "s3-11.mp3",
  "hash": "f3a01290119f11f8",
  "text": "陽太！遅い！早く来なさい！",
  "voice": "Despina"
 },
 "s3-12": {
  "file": "s3-12.mp3",
  "hash": "1eee1fa3d8c87910",
  "text": "うわっ、部長だ！じゃあな、シャオユー！",
  "voice": "Fenrir"
 },
 "s3-13": {
  "file": "s3-13.mp3",
  "hash": "db699ff5d174b047",
  "text": "ラジオ部……？",
  "voice": "Leda"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "7878b9c744d5097d",
  "text": "兄は医者です。わたしは医者じゃないです。",
  "voice": "Sulafat"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "90b7e4468878b083",
  "text": "この傘はわたしのじゃないです。",
  "voice": "Sulafat"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "b89641accb900cb6",
  "text": "マリアさんはブラジルから来ました。",
  "voice": "Sulafat"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "a4b807a7156ed247",
  "text": "田中さんは北海道から来ました。",
  "voice": "Sulafat"
 },
