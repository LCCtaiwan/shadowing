{
 "recap": {
  "file": "recap.mp3",
  "hash": "40d5c59d38643323",
  "text": "シャオユーはラジオ部に入りました。今日は初めての録音です。",
  "voice": "Schedar",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "28e8cea26e2d64cd",
  "text": "今日はマイクテストよ。ルールをいうから、よく聞きなさい。",
  "voice": "Despina",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "b8b9c8db5e6cb236",
  "text": "一つ。マイクを叩いてはいけない。",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "5854f45a8a580df6",
  "text": "二つ。マイクの前で、お菓子を食べちゃだめですぅ。",
  "voice": "Achernar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "bdbf3e62ff0f3609",
  "text": "三つ！大きい声を出しちゃだめだぜ！",
  "voice": "Fenrir",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "eefd87b261cbc796",
  "text": "……あなたが一番うるさいの！",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "e499eaf54d2748cb",
  "text": "あの、質問です。ドラマでも、です・ますで話しますか？",
  "voice": "Leda",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-07": {
  "file": "s1-07.mp3",
  "hash": "b9ba88ba1d090e56",
  "text": "だめ。ドラマは普通の話し方よ。『学生です』は『学生だ』。",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-08": {
  "file": "s1-08.mp3",
  "hash": "2827d42ebe5ac39a",
  "text": "『行きます』は『行く』。『行きません』は『行かない』ですぅ。",
  "voice": "Achernar",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-09": {
  "file": "s1-09.mp3",
  "hash": "e79d3639b87e05d1",
  "text": "じゃあ……『わたしは勇者だ。逃げない』？",
  "voice": "Leda",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "ddc5c288f76ef5fd",
  "text": "次は早口言葉よ。『となりのトナカイ、時計を止めた』。",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "c82c776a5901cc69",
  "text": "よし！となりのトナカイ、とけ……とかげ……？",
  "voice": "Fenrir",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "2db4adf9a4fbaf18",
  "text": "となりのトナカイ、時計を……止めた！",
  "voice": "Leda",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "d935f42f0683d13c",
  "text": "シャオユー、悪くない。陽太は、だめ。",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "75e53decae6a4540",
  "text": "雨の音、いきますぅ。……ジュージュー。",
  "voice": "Achernar",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "06538f79ef6b5be0",
  "text": "それ、焼肉の音だろ！",
  "voice": "Fenrir",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "a3d97f523a914c32",
  "text": "……もういい。録音、スタート！",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "9774802ffd0a8b07",
  "text": "ここは暗い森。勇者は一人で歩く。",
  "voice": "Leda",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-02": {
  "file": "s3-02.mp3",
  "hash": "39a243f8cbb210c0",
  "text": "俺は勇者だ！魔王、どこだ！",
  "voice": "Fenrir",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-03": {
  "file": "s3-03.mp3",
  "hash": "f5c6643e8023d211",
  "text": "ふふふ……ここだ。人間は、この森に入ってはいけない。",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-04": {
  "file": "s3-04.mp3",
  "hash": "97783d9b3615976f",
  "text": "帰らない！俺は逃げないぜ！",
  "voice": "Fenrir",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-05": {
  "file": "s3-05.mp3",
  "hash": "272a0aca77234e55",
  "text": "そのとき、空で雷が鳴った。",
  "voice": "Leda",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-06": {
  "file": "s3-06.mp3",
  "hash": "bfc98f8d29a76290",
  "text": "ピヨピヨ、ピヨピヨ～。",
  "voice": "Achernar",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-07": {
  "file": "s3-07.mp3",
  "hash": "01e2e3febdd423a1",
  "text": "……雷じゃない！ひよこだ！",
  "voice": "Despina",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-08": {
  "file": "s3-08.mp3",
  "hash": "a296bbcfbf885dfe",
  "text": "すみませぇん。雷の音、忘れたんですぅ。",
  "voice": "Achernar",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s3-09": {
  "file": "s3-09.mp3",
  "hash": "7de113c53aa4d9f4",
  "text": "ふふっ……ラジオ部、楽しいです。",
  "voice": "Leda",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "5ca1bdcbb586b4a4",
  "text": "あしたは休みだ。学校に行かない。",
  "voice": "Sulafat",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "d2684bf96bb6b277",
  "text": "今日は雨じゃない。公園で遊ぶ。",
  "voice": "Sulafat",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "d73c90a94488e0ee",
  "text": "ここで写真を撮ってはいけません。",
  "voice": "Sulafat",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "81039ecbe6dfe529",
  "text": "夜、一人で出かけちゃだめだよ。",
  "voice": "Sulafat",
  "model": "gemini-3.1-flash-tts-preview"
 },
