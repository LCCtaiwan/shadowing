{
 "recap": {
  "file": "recap.mp3",
  "hash": "a9ec096cd8ef399a",
  "text": "シャオユーはラジオ部に入りました。部員はよにんになりました。",
  "voice": "Schedar",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "959d5efaad7ce6e7",
  "text": "よし、昼休みだ！シャオユー、購買に行くぜ！",
  "voice": "Fenrir",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "93e11e513ae8457e",
  "text": "購買は、パンを買うところですか？",
  "voice": "Leda",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "debb73c39ef978d0",
  "text": "そうだ。焼きそばパンは、毎日じゅっこだけなんだ。",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "9f0816e37a93ee94",
  "text": "あんた、また焼きそばパン？カレーパンのほうがおいしいじゃない。",
  "voice": "Despina",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "a025b2ef5794031d",
  "text": "いや、カレーパンより焼きそばパンのほうがうまいだろ！",
  "voice": "Fenrir",
  "model": "gemini-3.1-flash-tts-preview"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "5593ee849e39e58f",
  "text": "焼きそばパンは、いくらですか？",
  "voice": "Leda",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-07": {
  "file": "s1-07.mp3",
  "hash": "af4cd088aa6790bd",
  "text": "百五十円よ。カレーパンより三十円安いの。",
  "voice": "Despina",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-08": {
  "file": "s1-08.mp3",
  "hash": "f9c6b7719080718f",
  "text": "時間がないぞ！走れ！",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-09": {
  "file": "s1-09.mp3",
  "hash": "c22a25a5f3a5b6f3",
  "text": "あっ、廊下は走ってはいけませんよ！",
  "voice": "Leda",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "89de534667fbeb55",
  "text": "はいはい、次の人！焼きそば？カレー？メロン？早く言って！",
  "voice": "Gacrux",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "b2186f615d8d0c68",
  "text": "えっと、焼きそばパンと…いや、カレーパンも…。",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "39e3ec3ac413e030",
  "text": "はい、遅い！次！",
  "voice": "Gacrux",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "373f7ecf31000744",
  "text": "焼きそばパン、いっこください！",
  "voice": "Callirrhoe",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "8d53c48cacd7c13f",
  "text": "はい、百五十円ね。焼きそばパンは、これでおしまい！",
  "voice": "Gacrux",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "56f51f9a9a4fded9",
  "text": "ええっ！？俺の焼きそばパンが…！",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "2fc5f73776481eb8",
  "text": "ごめんね。あんたの口より、おばちゃんの手のほうが速いのよ！",
  "voice": "Gacrux",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-08": {
  "file": "s2-08.mp3",
  "hash": "508de9e33094bef3",
  "text": "すみません、メロンパンを一つと、牛乳をください。",
  "voice": "Leda",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-09": {
  "file": "s2-09.mp3",
  "hash": "18168e72d1c1a8c2",
  "text": "はい、二百円ね！そっちのおにいさんは？残ってるのは、コッペパンだけよ。",
  "voice": "Gacrux",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "aca8aa918bc5984c",
  "text": "で、あんたの昼ごはんは、コッペパンだけ？",
  "voice": "Despina",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-02": {
  "file": "s3-02.mp3",
  "hash": "b98fb4b980be6686",
  "text": "うるさい…。俺は、コッペパンも好きだぜ…。",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-03": {
  "file": "s3-03.mp3",
  "hash": "0865936bc2a7eeb5",
  "text": "陽太先輩、わたしのクッキー、一枚だけあげますねぇ。",
  "voice": "Achernar",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-04": {
  "file": "s3-04.mp3",
  "hash": "621b42567594cca1",
  "text": "わたしのメロンパンも、半分どうぞ。",
  "voice": "Leda",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-05": {
  "file": "s3-05.mp3",
  "hash": "a1b5fde87ca40f79",
  "text": "シャオユー…ひな…！お前ら、いいやつだな！",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-08": {
  "file": "s3-08.mp3",
  "hash": "d592fe0374cd65ef",
  "text": "あしたは、みんなで早く行きましょう。",
  "voice": "Leda",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-07": {
  "file": "s3-07.mp3",
  "hash": "26873adfa5508d5f",
  "text": "みんな、ありがとう！焼きそばパンより、みんなのパンのほうがうまいぜ！",
  "voice": "Fenrir",
  "model": "gemini-3.8-flash-tts"
 },
 "s3-06": {
  "file": "s3-06.mp3",
  "hash": "d5ba47d72f34ae3b",
  "text": "べ、別に…わたしのカレーパンも、少しだけならあげてもいいわよ。",
  "voice": "Despina",
  "model": "gemini-3.8-flash-tts"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "4050e5e464de2f5d",
  "text": "電車よりバスのほうが安いです。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "274c103f2fa715a8",
  "text": "わたしは夏より冬のほうが好きです。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "9c946a3fbdbc6c6f",
  "text": "財布の中に、百円だけあります。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "6924f0d2af9d56b0",
  "text": "今日は一時間だけ勉強しました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
