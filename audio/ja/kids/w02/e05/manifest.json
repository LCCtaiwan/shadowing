{
 "recap": {
  "file": "recap.mp3",
  "hash": "a9662f6e6f55af5f",
  "text": "きょうは大きいお店に来ました。人がたくさんいます。",
  "voice": "Schedar",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "7474a538d27fb4b0",
  "text": "ママ…？ママ、いない…。",
  "voice": "Pulcherrima",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "27332d6f131b58d2",
  "text": "だいじょうぶ。ここで待とう。動かないよ。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "a4eb36fb6464efa4",
  "text": "どうしたの？おばさんといっしょに、ママを探しに行こうか。",
  "voice": "Aoede",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "cf8643c6a0cdf71c",
  "text": "いいえ、行きません。ここで待ちます。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "95afc7149e8334e6",
  "text": "お店の人を呼んでください。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "872689af299dd75a",
  "text": "わかった。ちょっと待っててね。",
  "voice": "Aoede",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "1d3a144edf8d2729",
  "text": "どうしましたか。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "e8b1592adc989254",
  "text": "ママがいません。まいごです。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "4868fcdb0b0e7fe3",
  "text": "だいじょうぶですよ。お名前は？何歳ですか。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "8406974c4253f2cb",
  "text": "名前はシャオミーです。七歳です。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "d254291c7e781b68",
  "text": "弟はアーバオです。四歳です。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "bfbc5fe38c328f93",
  "text": "ママの電話番号、わかりますか。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "59508902f2dca61f",
  "text": "はい。このカードを見てください。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-08": {
  "file": "s2-08.mp3",
  "hash": "d018a08ec69e1ba8",
  "text": "ママの電話番号と、ホテルの名前ですね。すぐ電話します。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-09": {
  "file": "s2-09.mp3",
  "hash": "f1715a7bd063f07c",
  "text": "ここで待っていてください。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-10": {
  "file": "s2-10.mp3",
  "hash": "881ccf478cb55b7f",
  "text": "シャオミー！アーバオ！",
  "voice": "Autonoe",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-11": {
  "file": "s2-11.mp3",
  "hash": "a08b0ba400228f89",
  "text": "ママ！ここで待ってたよ！",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-12": {
  "file": "s2-12.mp3",
  "hash": "fc9025e2849f0c93",
  "text": "本当にありがとうございました。",
  "voice": "Autonoe",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "c1035ef96ffdc347",
  "text": "名前はそうたです。六歳です。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "929d514c38254527",
  "text": "ママの名前はかけいです。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "8992ca4fc4a950ee",
  "text": "ママに電話してください。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "e8d75803396a5799",
  "text": "ゆっくり話してください。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
