{
 "recap": {
  "file": "recap.mp3",
  "hash": "b5353daae915d2cc",
  "text": "きょうは、家族で水族館に来ました。大きい魚がたくさんいます。",
  "voice": "Schedar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "73595905ae760b0f",
  "text": "おねえちゃん、トイレ、行きたい…。",
  "voice": "Pulcherrima",
  "model": "gemini-2.5-flash-preview-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "1ea8993a8f86cd8d",
  "text": "えっ、トイレ？ちょっと待ってね。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "362718fbfbfe1ce5",
  "text": "すみません。トイレはどこですか。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "51ad3e398c3e9d0a",
  "text": "トイレですね。あそこのエレベーターの横ですよ。",
  "voice": "Kore",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "509c87e65243fd24",
  "text": "エレベーターの横ですね。ありがとうございます！",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "4e593e0586e8ae77",
  "text": "ありがとう！",
  "voice": "Pulcherrima",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "e804434464a44c73",
  "text": "ペンギン、見たい！",
  "voice": "Pulcherrima",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "0e27f10836b39ed6",
  "text": "わたしも！すみません、ペンギンが見たいです。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "a9f74ce08bb72472",
  "text": "ペンギンはどこですか。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "b99b88a907651955",
  "text": "ペンギンは二階ですよ。あの階段を上がってください。",
  "voice": "Charon",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "2b5de77c77d7f244",
  "text": "おねえちゃん、お水、飲みたい。",
  "voice": "Pulcherrima",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-08": {
  "file": "s2-08.mp3",
  "hash": "d3bbd28cf9f6a4c4",
  "text": "すみません、お水はどこですか。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-09": {
  "file": "s2-09.mp3",
  "hash": "fa9906e4fd2d1067",
  "text": "水飲み場は、トイレの前にありますよ。",
  "voice": "Charon",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "e017fbcb663da678",
  "text": "おもちゃやさんは、どこですか。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "4c4ec070108205be",
  "text": "すみません、出口はどこですか。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "49359540fba35abb",
  "text": "二階ですね。ありがとうございます！",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "4383e2d98255019d",
  "text": "わあ、ペンギン！かわいいね。",
  "voice": "Laomedeia",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "80ef47208fc444b9",
  "text": "アイスが食べたいです。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g2-ex2": {
  "file": "g2-ex2.mp3",
  "hash": "187e7bd7ce5a759e",
  "text": "公園であそびたいです。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
