{
 "recap": {
  "file": "recap.mp3",
  "hash": "655e80d3190b616c",
  "text": "十五になった桃太郎は、鬼せいばつに出かけました。おばあさんが作ったきびだんごを持っています。",
  "voice": "Schedar",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-01": {
  "file": "s1-01.mp3",
  "hash": "bd3c827db56b845b",
  "text": "桃太郎はずんずん行きますと、大きな山の上に来ました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-02": {
  "file": "s1-02.mp3",
  "hash": "3a0fc862553a5a2e",
  "text": "すると、草むらの中から、",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-03": {
  "file": "s1-03.mp3",
  "hash": "e367b8a3ac7baa9c",
  "text": "「ワン、ワン。」と声をかけながら、犬がいっぴきかけて来ました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-04": {
  "file": "s1-04.mp3",
  "hash": "1b738cfd2cc938c3",
  "text": "桃太郎がふり返ると、犬はていねいに、おじぎをして、",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-05": {
  "file": "s1-05.mp3",
  "hash": "4a271699cf1f66c5",
  "text": "「桃太郎さん、桃太郎さん、どちらへおいでになります。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-06": {
  "file": "s1-06.mp3",
  "hash": "8df305d03eae4680",
  "text": "とたずねました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-07": {
  "file": "s1-07.mp3",
  "hash": "5c73f0f581f002f1",
  "text": "「鬼が島へ、鬼せいばつに行くのだ。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-08": {
  "file": "s1-08.mp3",
  "hash": "714d1636f7846524",
  "text": "「お腰に下げたものは、何でございます。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-09": {
  "file": "s1-09.mp3",
  "hash": "1fd1490b91aad990",
  "text": "「日本一のきびだんごさ。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-11": {
  "file": "s1-11.mp3",
  "hash": "62edc90e8c4f13d1",
  "text": "「よし、よし、やるから、ついて来い。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-10": {
  "file": "s1-10.mp3",
  "hash": "b597f18f79925e86",
  "text": "「一つ下さい、おともしましょう。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "f51b1eaee7107230",
  "text": "「桃太郎さん、桃太郎さん、どちらへおいでになります。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s1-12": {
  "file": "s1-12.mp3",
  "hash": "2e2aebdd6a2f0785",
  "text": "犬はきびだんごを一つもらって、桃太郎のあとから、ついて行きました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-01": {
  "file": "s2-01.mp3",
  "hash": "78a54f0f062e6402",
  "text": "山を下りてしばらく行くと、こんどは森の中にはいりました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-02": {
  "file": "s2-02.mp3",
  "hash": "8da1a6ea6027d59d",
  "text": "すると木の上から、",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-03": {
  "file": "s2-03.mp3",
  "hash": "6446a543980f02a6",
  "text": "「キャッ、キャッ。」とさけびながら、猿がいっぴき、かけ下りて来ました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-04": {
  "file": "s2-04.mp3",
  "hash": "40518cee8e155c93",
  "text": "桃太郎がふり返ると、猿はていねいに、おじぎをして、",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-tts"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "8df305d03eae4680",
  "text": "とたずねました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "5967d155dee5b69e",
  "text": "「鬼が島へ鬼せいばつに行くのだ。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-08": {
  "file": "s2-08.mp3",
  "hash": "c3b403333c7a768a",
  "text": "「お腰に下げたものは、何でございます。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-09": {
  "file": "s2-09.mp3",
  "hash": "1fd1490b91aad990",
  "text": "「日本一のきびだんごさ。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-10": {
  "file": "s2-10.mp3",
  "hash": "aa48d74727a391fd",
  "text": "「一つ下さい、おともしましょう。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-11": {
  "file": "s2-11.mp3",
  "hash": "62edc90e8c4f13d1",
  "text": "「よし、よし、やるから、ついて来い。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s2-12": {
  "file": "s2-12.mp3",
  "hash": "39265d56cb3b1080",
  "text": "猿もきびだんごを一つもらって、あとからついて行きました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "5dae697dffc0af63",
  "text": "山を下りて、森をぬけて、こんどはひろい野原へ出ました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s3-02": {
  "file": "s3-02.mp3",
  "hash": "926856e3992f9975",
  "text": "すると空の上で、",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s3-03": {
  "file": "s3-03.mp3",
  "hash": "2410bc3bb645d0b8",
  "text": "「ケン、ケン。」と鳴く声がして、きじがいち羽とんで来ました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s3-04": {
  "file": "s3-04.mp3",
  "hash": "2fff140298c88d1d",
  "text": "桃太郎がふり返ると、きじはていねいに、おじぎをして、",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s3-05": {
  "file": "s3-05.mp3",
  "hash": "76d8acaaea7e3791",
  "text": "「桃太郎さん、桃太郎さん、どちらへおいでになります。」",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
