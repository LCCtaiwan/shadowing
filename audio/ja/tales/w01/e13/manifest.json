  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "s3-12": {
  "file": "s3-12.mp3",
  "hash": "5d127d072ebf91cf",
  "text": "きじもきびだんごを一つもらって、桃太郎のあとからついて行きました。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g1-ex1": {
  "file": "g1-ex1.mp3",
  "hash": "9b52953890ce7b35",
  "text": "先生はなんじごろおいでになりますか。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g1-ex2": {
  "file": "g1-ex2.mp3",
  "hash": "87c0b00e61536c95",
  "text": "社長は今、会議室においでになります。",
  "voice": "Sulafat",
  "model": "gemini-3.8-flash-lite-tts"
 },
 "g2-ex1": {
  "file": "g2-ex1.mp3",
  "hash": "4a9b9185d5c732d6",
  "text": "お荷物をお持ちしましょう。",
