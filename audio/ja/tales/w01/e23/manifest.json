  "hash": "c0105147c59974ad",
  "text": "かすむ",
  "voice": "Schedar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "ja:vocab:咲き乱れる": {
  "file": "v-c169f11d2dcc.mp3",
  "hash": "2cd2ebf9e05b3117",
  "text": "さきみだれる",
  "voice": "Schedar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "ja:vocab:舞う": {
  "file": "v-95da88866422.mp3",
  "hash": "be7d97e3d8a24e39",
  "text": "まう",
  "voice": "Schedar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "ja:vocab:霧": {
  "file": "v-3429b385f7ed.mp3",
  "hash": "99dd1c9a419e2b7b",
  "text": "きり",
  "voice": "Schedar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "ja:vocab:酔う": {
  "file": "v-97d8d7120ebd.mp3",
  "hash": "dc9d45b3b20b59b7",
  "text": "よう",
  "voice": "Schedar",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s2-05": {
  "file": "s2-05.mp3",
  "hash": "39c0506a8cba7624",
  "text": "と、乙姫さまはいって、ていねいにおじぎしました。",
  "voice": "Sulafat",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s2-06": {
  "file": "s2-06.mp3",
  "hash": "7766bf95165ae47f",
  "text": "やがて、たいをかしらに、かつおだの、ふぐだの、えびだの、たこだの、",
  "voice": "Sulafat",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s2-07": {
  "file": "s2-07.mp3",
  "hash": "08762bc48188fd17",
  "text": "大小いろいろのおさかなが、めずらしいごちそうを山とはこんできて、にぎやかなお酒盛がはじまりました。",
  "voice": "Sulafat",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s2-08": {
  "file": "s2-08.mp3",
  "hash": "582527685eab2c69",
  "text": "きれいな腰元たちは、歌をうたったり踊りをおどったりしました。",
  "voice": "Sulafat",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s2-09": {
  "file": "s2-09.mp3",
  "hash": "e04385f78b9c35d0",
  "text": "浦島はただもう夢のなかで夢を見ているようでした。",
  "voice": "Sulafat",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "s3-01": {
  "file": "s3-01.mp3",
  "hash": "a270bd33cffc6296",
  "text": "ごちそうがすむと、浦島はまた乙姫さまの案内で、御殿のなかをのこらず見せてもらいました。",
  "voice": "Sulafat",
  "model": "gemini-2.5-pro-preview-tts"
 }
}
